contains
  !-----------------------------------------------------------------------------
  !> value at XYW
!OCL SERIAL
  subroutine ATMOS_DYN_FVM_flux_valueW_Z_<%=@scheme%>( &
       valW,             &
       mflx, val, GSQRT, &
       CDZ               )
    !$acc routine vector
    implicit none

    real(RP), intent(out) :: valW (KA)
    real(RP), intent(in)  :: mflx (KA)
    real(RP), intent(in)  :: val  (KA)
    real(RP), intent(in)  :: GSQRT(KA)
    real(RP), intent(in)  :: CDZ  (KA)

    integer  :: k
<%- if fuse_lu -%>
#ifdef _OPENACC
    real(RP) :: vlo, vup, vin
#endif
<%- end -%>
    !---------------------------------------------------------------------------

<%- if fuse_lu -%>
#ifdef _OPENACC
    ! The values at KS and KE-1 are selected with merge() in the loop for the inner levels.
    ! KE-1 is tested first, so that it takes precedence over KS when KS == KE-1 (KMAX = 2).
    ! val(KS-1) and val(KE+1) are read but not used.
    do k = KS, KE-1
       vlo = <%= flux_bnd("mflx(k)", order_lo(order, nh), 0, "k", nil, nil, 1) %>
       vup = <%= flux_bnd("mflx(k)", order_up(order, nh), 0, "k", nil, nil, 1) %>
       vin = <%= flux("mflx(k)", order, 0, "k", nil, nil, 1) %>
       valW(k) = merge( vup, merge( vlo, vin, k == KS ), k == KE-1 )
    enddo
#else
<%- end -%>
    do k = KS<%=nh%>, KE<%=-(nh+1)%>
#ifdef DEBUG
       call CHECK( __LINE__, mflx(k) )
<% (nh+1).times do |k| %>
       call CHECK( __LINE__, val(k<%=-k%>) )
       call CHECK( __LINE__, val(k<%=k+1%>) )
<% end %>
#endif
       valW(k)       = <%= flux("mflx(k)", order, 0, "k", nil, nil, 1) %>
    enddo
#ifdef DEBUG
    k = IUNDEF
#endif

#ifdef DEBUG
<% nh.times do |k| %>
       call CHECK( __LINE__, mflx(KS<%=k%>) )
       call CHECK( __LINE__, val(KS<%=k*2%>  ) )
       call CHECK( __LINE__, val(KS<%=k*2+1%>) )
       call CHECK( __LINE__, mflx(KE<%=-k-1%>) )
       call CHECK( __LINE__, val(KE<%=-k*2%>  ) )
       call CHECK( __LINE__, val(KE<%=-k*2-1%>) )
<% end %>
#endif
<% nh.times do |k| %>
       valW(KS<%=k%>) = <%= flux("mflx(KS#{k})", [[order-(nh-k)*2,[order,2].min].max,[order-(nh-k-1)*2,[order,2].min].max], 0, "KS"+k, nil, nil, 1) %>
       valW(KE<%=-k-1%>) = <%= flux("mflx(KE#{-(k+1)})", [[order-(nh-k-1)*2,[order,2].min].max,[order-(nh-k)*2,[order,2].min].max], 0, "KE"-(k+1), nil, nil, 1) %>
<% end %>
<%- if fuse_lu -%>
#endif
<%- end -%>

    return
  end subroutine ATMOS_DYN_FVM_flux_ValueW_Z_<%=@scheme%>

  !-----------------------------------------------------------------------------
  !> calculation z-flux at XYZ
  subroutine ATMOS_DYN_FVM_fluxZ_XYZ_<%=@scheme%>( &
       flux,              &
       mflx, val, GSQRT,  &
       num_diff,          &
       CDZ,               &
       IIS, IIE, JJS, JJE )
    use scale_const, only: &
      EPS => CONST_EPS
    implicit none

    real(RP), intent(inout) :: flux    (KA,IA,JA)
    real(RP), intent(in)  :: mflx    (KA,IA,JA)
    real(RP), intent(in)  :: val     (KA,IA,JA)
    real(RP), intent(in)  :: GSQRT   (KA,IA,JA)
    real(RP), intent(in)  :: num_diff(KA,IA,JA)
    real(RP), intent(in)  :: CDZ     (KA)
    integer,  intent(in)  :: IIS, IIE, JJS, JJE

    real(RP) :: vel
<%- if fuse_lu -%>
#ifdef _OPENACC
    real(RP) :: flo, fup, fin
#endif
<%- end -%>
    integer  :: k, i, j
    !---------------------------------------------------------------------------

    !$omp parallel default(none) private(i,j,k, vel)                    &
    !$omp shared(JJS,JJE,IIS,IIE,KS,KE,mflx,val,flux,GSQRT,num_diff,EPS)

    !$acc data copy(flux) copyin(mflx, val, GSQRT, num_diff, CDZ)

<%- if fuse_lu -%>
#ifdef _OPENACC
    ! The fluxes at the boundary levels are selected with merge() in the kernel for
    ! the inner levels. KE-1 is tested first, so that it takes precedence over KS
    ! when KS == KE-1 (KMAX = 2). In a separate kernel over (i,j), the accesses to these
    ! k-contiguous arrays are strided.
    ! The values in the halo, val(KS-2:KS-1) and val(KE+1:KE+2), are read but not used.
    !$acc parallel loop collapse(3) async
    do j = JJS, JJE
    do i = IIS, IIE
    do k = KS-1, KE
       vel = mflx(k,i,j)
       flo = <%= flux_bnd("vel", order_lo(order, nh), 0) %>
       fup = <%= flux_bnd("vel", order_up(order, nh), 0) %>
       fin = <%= flux("vel", order, 0) %>
       flux(k,i,j) = merge( vel &
                   * ( merge( fup, merge( flo, fin, k == KS ), k == KE-1 ) ) <%= num_diff() %>, &
                            0.0_RP, KS <= k .and. k <= KE-1 )
    enddo
    enddo
    enddo
#else
<%- end -%>
    !$omp do OMP_SCHEDULE_ collapse(2)
    !$acc parallel loop collapse(3) async
    do j = JJS, JJE
    do i = IIS, IIE
    do k = KS<%=nh%>, KE<%=-(nh+1)%>
#ifdef DEBUG
       call CHECK( __LINE__, mflx(k,i,j) )
<% (nh+1).times do |k| %>
       call CHECK( __LINE__, val(k<%=-k%>,i,j) )
       call CHECK( __LINE__, val(k<%=k+1%>,i,j) )
<% end %>
#endif
       vel = mflx(k,i,j)
       flux(k,i,j) = vel &
                   * ( <%= flux("vel", order,0) %> ) <%= num_diff() %>
    enddo
    enddo
    enddo
    !$omp end do nowait
#ifdef DEBUG
    k = IUNDEF; i = IUNDEF; j = IUNDEF
#endif

    !$omp do OMP_SCHEDULE_ collapse(2)
    !$acc kernels async
    do j = JJS, JJE
    do i = IIS, IIE
#ifdef DEBUG
<% nh.times do |k| %>
       call CHECK( __LINE__, mflx(KS<%=k%>,i,j) )
       call CHECK( __LINE__, val(KS<%=k*2%>  ,i,j) )
       call CHECK( __LINE__, val(KS<%=k*2+1%>,i,j) )
       call CHECK( __LINE__, mflx(KE<%=-k-1%>,i,j) )
       call CHECK( __LINE__, val(KE<%=-k*2%>  ,i,j) )
       call CHECK( __LINE__, val(KE<%=-k*2-1%>,i,j) )
<% end %>
#endif
       flux(KS-1,i,j) = 0.0_RP
<% nh.times do |k| %>
       vel = mflx(KS<%=k%>,i,j)
       flux(KS<%=k%>,i,j) = vel &
                   * ( <%= flux("vel", [[order-(nh-k)*2,[order,2].min].max,[order-(nh-k-1)*2,[order,2].min].max], 0, "KS"+k) %> ) <%= num_diff("KS"+k) %>
       vel = mflx(KE<%=-(k+1)%>,i,j)
       flux(KE<%=-k-1%>,i,j) = vel &
                   * ( <%= flux("vel", [[order-(nh-k-1)*2,[order,2].min].max,[order-(nh-k)*2,[order,2].min].max], 0, "KE"-(k+1)) %> ) <%= num_diff("KE"-(k+1)) %>
<% end %>
       flux(KE  ,i,j) = 0.0_RP
    enddo
    enddo
    !$acc end kernels
    !$omp end do nowait
<%- if fuse_lu -%>
#endif
<%- end -%>

    !$acc end data

    !$omp end parallel
#ifdef DEBUG
    k = IUNDEF; i = IUNDEF; j = IUNDEF
#endif

    return
  end subroutine ATMOS_DYN_FVM_fluxZ_XYZ_<%=@scheme%>
<% [
     ["X", 1, 0],
     ["Y", 0, 1]
   ].each do |dir,i,j|
%>
  !-----------------------------------------------------------------------------
  !> calculation <%=dir%>-flux at XYZ
  subroutine ATMOS_DYN_FVM_flux<%=dir%>_XYZ_<%=@scheme%>( &
       flux,              &
       mflx, val, GSQRT,  &
       num_diff,          &
       CDZ,               &
       IIS, IIE, JJS, JJE )
    implicit none

    real(RP), intent(inout) :: flux    (KA,IA,JA)
    real(RP), intent(in)  :: mflx    (KA,IA,JA)
    real(RP), intent(in)  :: val     (KA,IA,JA)
    real(RP), intent(in)  :: GSQRT   (KA,IA,JA)
    real(RP), intent(in)  :: num_diff(KA,IA,JA)
    real(RP), intent(in)  :: CDZ(KA)
    integer,  intent(in)  :: IIS, IIE, JJS, JJE

    real(RP) :: vel
    integer  :: k, i, j
    !---------------------------------------------------------------------------

    !$omp parallel do default(none) private(i,j,k) OMP_SCHEDULE_ collapse(2) &
    !$omp private(vel) &
    !$omp shared(JJS,JJE,IIS,IIE,KS,KE,mflx,val,flux,GSQRT,num_diff)
    !$acc parallel loop collapse(3) async
    do j = JJS<%=-j%>, JJE
    do i = IIS<%=-i%>, IIE
    do k = KS, KE
#ifdef DEBUG
       call CHECK( __LINE__, mflx(k,i,j) )
<% (nh+1).times do |n| %>
       call CHECK( __LINE__, val(k,i<%=-n*i%>,j<%=-n*j%>) )
       call CHECK( __LINE__, val(k,i<%=(n+1)*i%>,j<%=(n+1)*j%>) )
<% end %>
#endif
       vel = mflx(k,i,j)
       flux(k,i,j) = vel &
                   * ( <%=flux("vel", order, i+j*2)%> ) <%= num_diff() %>
    enddo
    enddo
    enddo
#ifdef DEBUG
    k = IUNDEF; i = IUNDEF; j = IUNDEF
#endif

    return
  end subroutine ATMOS_DYN_FVM_flux<%=dir%>_XYZ_<%=@scheme%>
<% end %>
<%# end X Y loop %>
  !-----------------------------------------------------------------------------
  !> calculation z-flux at XYW
  subroutine ATMOS_DYN_FVM_fluxZ_XYW_<%=@scheme%>( &
       flux,              &
       mom, val, DENS,    &
       GSQRT, J33G,       &
       num_diff,          &
       CDZ, FDZ,          &
       dtrk,              &
       IIS, IIE, JJS, JJE )
    implicit none

    real(RP), intent(inout) :: flux    (KA,IA,JA)
    real(RP), intent(in)  :: mom     (KA,IA,JA)
    real(RP), intent(in)  :: val     (KA,IA,JA)
    real(RP), intent(in)  :: DENS    (KA,IA,JA)
    real(RP), intent(in)  :: GSQRT   (KA,IA,JA)
    real(RP), intent(in)  :: J33G
    real(RP), intent(in)  :: num_diff(KA,IA,JA)
    real(RP), intent(in)  :: CDZ     (KA)
    real(RP), intent(in)  :: FDZ     (KA-1)
    real(RP), intent(in)  :: dtrk
    integer,  intent(in)  :: IIS, IIE, JJS, JJE

    real(RP) :: vel
    integer  :: k, i, j
    !---------------------------------------------------------------------------

    ! note than z-index is added by -1

    !$omp parallel default(none) private(i,j,k,vel)  &
    !$omp shared(JJS,JJE,IIS,IIE,KS,KE,mom,val,flux,J33G,GSQRT,num_diff,DENS,FDZ,dtrk)

    !$acc data copy(flux) copyin(mom, val, DENS, GSQRT, num_diff, CDZ, FDZ)

    !$omp do OMP_SCHEDULE_ collapse(2)
    !$acc parallel loop collapse(3) async
    do j = JJS, JJE
    do i = IIS, IIE
    do k = KS<%=nh+1%>, KE<%=-[nh,1].max%>
#ifdef DEBUG
       call CHECK( __LINE__, mom(k-1,i,j) )
       call CHECK( __LINE__, mom(k  ,i,j) )
<% (nh+1).times do |k| %>
       call CHECK( __LINE__, val(k<%=-k-1%>,i,j) )
       call CHECK( __LINE__, val(k<%=k%>,i,j) )
<% end %>
#endif
       vel = <%= interp("mom", "XYW", "XYZ") %> &
           / DENS(k,i,j)
       flux(k-1,i,j) = J33G * vel &
                   * ( <%= flux("vel", order, 0, "k-1") %> ) <%= num_diff() %>
    enddo
    enddo
    enddo
    !$omp end do nowait
#ifdef DEBUG
    k = IUNDEF; i = IUNDEF; j = IUNDEF
#endif

    !$omp do OMP_SCHEDULE_ collapse(2)
    !$acc kernels async
    do j = JJS, JJE
    do i = IIS, IIE
#ifdef DEBUG
<% if nh >= 1 %>
<%- 0.upto(2*nh-1+order%2) do |k| -%>
       call CHECK( __LINE__, val(KS<%=k%>,i,j) )
<%- end -%>
<% end %>
<% if nh >= 2 %>
<%- (2*nh-1+order%2).downto(1) do |k| -%>
       call CHECK( __LINE__, val(KE<%=-k%>,i,j) )
<%- end -%>
<% end %>
#endif
       ! The boundary condition is qflx_hi + qflxJ13 + qfluxJ23 = 0 at KS.
       ! The flux at KS can be non-zero.
       ! To reduce calculations, all the fluxes are set to zero.
       flux(KS-1,i,j) = 0.0_RP ! k = KS
<% nh.times do |k| %>
       vel = <%= interp("mom", "XYW", "XYZ", "KS"+(k+1)) %> &
           / DENS(KS<%=k+1%>,i,j)
       flux(KS<%=k%>,i,j) = J33G * vel &
                   * ( <%= flux("vel", [[order-(nh-k)*2,[order,2].min].max,[order-(nh-k-1)*2,[order,2].min].max], 0, "KS"+k) %> ) <%= num_diff("KS"+(k+1)) %> ! k = KS<%=k+1%>
<% end %>

<% (nh-2).downto(0) do |k| %>
       vel = <%= interp("mom", "XYW", "XYZ", "KE"-(k+1)) %> &
           / DENS(KE-1,i,j)
       flux(KE<%=-(k+2)%>,i,j) = J33G * vel &
                   * ( <%= flux("vel", [[order-(nh-(k+2))*2,[order,2].min].max,[order-(nh-(k+1))*2,[order,2].min].max], 0, "KE"-(k+2)) %> ) <%= num_diff("KE"-(k+1)) %> ! k = KE<%=-(k+1)%>
<% end %>
       flux(KE-1,i,j) = 0.0_RP ! k = KE
       flux(KE  ,i,j) = 0.0_RP ! k = KE+1
    enddo
    enddo
    !$acc end kernels
    !$omp end do nowait

    !$acc end data

    !$omp end parallel

    return
  end subroutine ATMOS_DYN_FVM_fluxZ_XYW_<%=@scheme%>

<% [
     ["J13", "UYZ", 1,0],
     ["J23", "XVZ", 0,1]
   ].each do |dir, uv, i, j|
%>
  !-----------------------------------------------------------------------------
  !> calculation <%=dir%>-flux at XYW
  subroutine ATMOS_DYN_FVM_flux<%=dir%>_XYW_<%=@scheme%>( &
       flux,              &
       mom, val, DENS,    &
       GSQRT, <%=dir%>G, RMAPF, &
       CDZ, TwoD,         &
       IIS, IIE, JJS, JJE )
    implicit none

    real(RP), intent(inout) :: flux    (KA,IA,JA)
    real(RP), intent(in)  :: mom     (KA,IA,JA)
    real(RP), intent(in)  :: val     (KA,IA,JA)
    real(RP), intent(in)  :: DENS    (KA,IA,JA)
    real(RP), intent(in)  :: GSQRT   (KA,IA,JA)
    real(RP), intent(in)  :: <%=dir%>G    (KA,IA,JA)
    real(RP), intent(in)  :: RMAPF   (   IA,JA,2) !< 1 / map factor
    real(RP), intent(in)  :: CDZ     (KA)
    logical,  intent(in)  :: TwoD
    integer,  intent(in)  :: IIS, IIE, JJS, JJE

    real(RP) :: vel
    integer  :: k, i, j
    !---------------------------------------------------------------------------

    !$omp parallel default(none) private(i,j,k,vel) &
    !$omp shared(JJS,JJE,IIS,IIE,KS,KE,mom,val,DENS,flux,<%=dir%>G,RMAPF)

    !$acc data copy(flux) copyin(mom, val, DENS, GSQRT, <%=dir%>G, RMAPF, CDZ)

    !$omp do OMP_SCHEDULE_ collapse(2)
    !$acc parallel loop collapse(3) async
    do j = JJS, JJE
    do i = IIS, IIE
    do k = KS<%=[nh,2].max%>, KE<%=-[nh,1].max%>
       vel = <%= interp("mom", uv, "XYZ") %> &
           / DENS(k,i,j)
       vel = vel * <%=dir%>G(k,i,j)
       flux(k-1,i,j) = vel * RMAPF(i,j,<%=i*2+j%>) &
                   * ( <%= flux("vel", order, 0, "k-1") %> )
    enddo
    enddo
    enddo
    !$omp end do nowait

    !$omp do OMP_SCHEDULE_ collapse(2)
    !$acc kernels async
    do j = JJS, JJE
    do i = IIS, IIE
       ! The boundary condition is qflx_hi + qflxJ13 + qfluxJ23 = 0 at KS.
       ! The flux at KS can be non-zero.
       ! To reduce calculations, all the fluxes are set to zero.
       flux(KS-1,i,j) = 0.0_RP ! k = KS

       ! physically incorrect but for numerical stability
       vel = ( <%= interp("mom", uv, "XYZ", "KS+1") %> / DENS(KS+1,i,j) &
             + <%= interp("mom", uv, "XYZ", "KS"  ) %> / DENS(KS  ,i,j) ) * 0.5_RP
!       vel = <%= interp("mom", uv, "XYZ", "KS+1") %> &
!           / DENS(KS+1,i,j)
       vel = vel * <%=dir%>G(KS+1,i,j)
       flux(KS,i,j) =  vel * RMAPF(i,j,<%=i*2+j%>) &
                   * ( <%= flux("vel", [[order-nh*2,[order,2].min].max,[order-(nh-1)*2,[order,2].min].max], 0, "KS") %> ) ! k = KS+1
<%   for k in 1...(nh-1) %>
       vel = <%= interp("mom", uv, "XYZ", "KS"+(k+1)) %> &
           / DENS(KS<%=k+1%>,i,j)
       vel = vel * <%=dir%>G(KS<%k+1%>,i,j)
       flux(KS<%=k%>,i,j) = vel * RMAPF(i,j,<%=i*2+j%>) &
                   * ( <%= flux("vel", [[order-(nh-k)*2,[order,2].min].max,[order-(nh-k-1)*2,[order,2].min].max], 0, "KS"+k) %> ) ! k = KS<%=k+1%>
<%   end %>
<%   (nh-1).times do |k| %>
       vel = <%= interp("mom", uv, "XYZ", "KE"-(k+1)) %> &
           / DENS(KE<%=-k-1%>,i,j)
       vel = vel * <%=dir%>G(KE<%=-k-1%>,i,j)
       flux(KE<%=-k-2%>,i,j) = vel * RMAPF(i,j,<%=i*2+j%>) &
                   * ( <%= flux("vel", [[order-(nh-k-1)*2,[order,2].min].max,[order-(nh-k)*2,[order,2].min].max], 0, "KE"-(k+2)) %> ) ! k = KE<%=-k-3%>
<%   end %>
       flux(KE-1,i,j) = 0.0_RP
    enddo
    enddo
    !$acc end kernels
    !$omp end do nowait

    !$acc end data

    !$omp end parallel

    return
  end subroutine ATMOS_DYN_FVM_flux<%=dir%>_XYW_<%=@scheme%>
<% end # J13, J23 loop %>
<%
  # body of the fused vertical flux of rho*w at the full level k (flux index k-1) with the scheme ord;
  # j13: with the part of J13G (3-D)
  zj_xyw_level = lambda do |k, ord, j13, ind|
    s = []
    s << "vel = #{interp("momz", "XYW", "XYZ", k)} &"
    s << "    / DENS(#{k},i,j)"
    s << "vz = J33G * vel"
    if j13
      s << "vx = #{interp("momx", "UYZ", "XYZ", k)} &"
      s << "   / DENS(#{k},i,j)"
      s << "vx = vx * J13G(#{k},i,j)"
      s << "vx = vx * MAPF(i,j,1)"
    end
    s << "vy = #{interp("momy", "XVZ", "XYZ", k)} &"
    s << "   / DENS(#{k},i,j)"
    s << "vy = vy * J23G(#{k},i,j)"
    s << "vy = vy * MAPF(i,j,2)"
    s << ( j13 ? "vt = vz + vx + vy" : "vt = vz + vy" ) if order.odd? # the face value of the central schemes does not depend on it
    s << "fv = #{flux("vt", ord, 0, k-1)}"
    s << "flux(#{k-1},i,j) = vz * fv #{num_diff(k)}".rstrip
    s << "fluxJ13(#{k-1},i,j) = vx * fv" if j13
    s << "fluxJ23(#{k-1},i,j) = vy * fv"
    s.join("\n").gsub(/^/, ind)
  end
-%>
  !-----------------------------------------------------------------------------
  !> calculation of the vertical flux at XYW: the three parts with one face value
  !!
  !! The three parts of the vertical flux of rho*w, those of ATMOS_DYN_FVM_fluxZ_XYW_<%=@scheme%> (flux),
  !! ATMOS_DYN_FVM_fluxJ13_XYW_<%=@scheme%> (fluxJ13) and ATMOS_DYN_FVM_fluxJ23_XYW_<%=@scheme%> (fluxJ23), are computed
<% if order.odd? -%>
  !! with one face value, whose upwind side is taken by the sign of the total contravariant vertical velocity
  !! J33G w + m_x J13G u + m_y J23G v, the sum of the velocities that multiply the face value in the three parts
  !! (issue #3754). The sum of the parts is then the flux of the total velocity at every level, including those
  !! where the order is reduced, and it vanishes for flow along the coordinate surfaces.
  !! Each part is the flux of the separate routine when its own velocity has the sign of the total one.
<% else -%>
  !! with one face value (issue #3754). With the central scheme the face value does not depend on the velocity,
  !! so the parts are those of the separate routines, except for the rounding.
<% end -%>
  !! The orders at the levels are those of ATMOS_DYN_FVM_fluxZ_XYW_<%=@scheme%>, and the fluxes at the full levels KS and KE,
  !! whose face value does not depend on the direction, are those of the separate routines.
  !! With TwoD, the part of J13G is not computed (fluxJ13 is not changed), and momx is not used.
  subroutine ATMOS_DYN_FVM_fluxZJ_XYW_<%=@scheme%>( &
       flux, fluxJ13, fluxJ23,   &
       momz, momx, momy, val,    &
       DENS, GSQRT,              &
       J33G, J13G, J23G, MAPF,   &
       num_diff,                 &
       CDZ, FDZ, dtrk, TwoD,     &
       IIS, IIE, JJS, JJE        )
    implicit none

    real(RP), intent(inout) :: flux    (KA,IA,JA)
    real(RP), intent(inout) :: fluxJ13 (KA,IA,JA)
    real(RP), intent(inout) :: fluxJ23 (KA,IA,JA)
    real(RP), intent(in)  :: momz    (KA,IA,JA)
    real(RP), intent(in)  :: momx    (KA,IA,JA)
    real(RP), intent(in)  :: momy    (KA,IA,JA)
    real(RP), intent(in)  :: val     (KA,IA,JA)
    real(RP), intent(in)  :: DENS    (KA,IA,JA)
    real(RP), intent(in)  :: GSQRT   (KA,IA,JA)
    real(RP), intent(in)  :: J33G
    real(RP), intent(in)  :: J13G    (KA,IA,JA)
    real(RP), intent(in)  :: J23G    (KA,IA,JA)
    real(RP), intent(in)  :: MAPF    (   IA,JA,2) !< map factor
    real(RP), intent(in)  :: num_diff(KA,IA,JA)
    real(RP), intent(in)  :: CDZ     (KA)
    real(RP), intent(in)  :: FDZ     (KA-1)
    real(RP), intent(in)  :: dtrk
    logical,  intent(in)  :: TwoD
    integer,  intent(in)  :: IIS, IIE, JJS, JJE

    real(RP) :: vel
    real(RP) :: vz, vx, vy ! velocities of the parts: J33G w, m_x J13G u, m_y J23G v
<% if order.odd? -%>
    real(RP) :: vt         ! total contravariant vertical velocity
<% end -%>
    real(RP) :: fv         ! face value
<% if order > 1 -%>
    real(RP) :: wlo, wup ! weights of the extrapolation of the face values at KS and KE
<% end -%>
    real(RP) :: cl(3), cu(3) ! weights of the velocities at KS and KE
    real(RP) :: cl1, cl2, cl3, cu1, cu2, cu3 ! the same as scalars, passed to the async kernel by value
    integer  :: k, i, j
    !---------------------------------------------------------------------------

<% if order > 1 -%>
    call bnd_face_weights( CDZ, wlo, wup )
<% end -%>
    call bnd_extrap_weights( CDZ, cl, cu )
    cl1 = cl(1); cl2 = cl(2); cl3 = cl(3)
    cu1 = cu(1); cu2 = cu(2); cu3 = cu(3)

    !$omp parallel default(none) private(i,j,k,vel,vz,vx,vy<%= order.odd? ? ",vt" : "" %>,fv) &
<% if order > 1 -%>
    !$omp shared(wlo,wup) &
<% end -%>
    !$omp shared(cl1,cl2,cl3,cu1,cu2,cu3,TwoD) &
    !$omp shared(JJS,JJE,IIS,IIE,KS,KE,momz,momx,momy,val,DENS,GSQRT,J33G,J13G,J23G,MAPF,num_diff) &
    !$omp shared(flux,fluxJ13,fluxJ23)

    !$acc data copy(flux, fluxJ13, fluxJ23) &
    !$acc      copyin(momz, momx, momy, val, DENS, GSQRT, J13G, J23G, MAPF, num_diff, CDZ, FDZ)

<% [ [false, "if ( .not. TwoD ) then"], [true, "else ! TwoD: without the part of J13G"] ].each do |twod, cond| -%>
    <%= cond %>

    !$omp do OMP_SCHEDULE_ collapse(2)
    !$acc parallel loop collapse(3) async
    do j = JJS, JJE
    do i = IIS, IIE
    do k = KS<%=nh+1%>, max( KE<%=-(nh+1)%>, KS<%=nh%> )
#ifdef DEBUG
       call CHECK( __LINE__, momz(k-1,i,j) )
       call CHECK( __LINE__, momz(k  ,i,j) )
<% unless twod -%>
       call CHECK( __LINE__, momx(k,i  ,j) )
       call CHECK( __LINE__, momx(k,i-1,j) )
<% end -%>
       call CHECK( __LINE__, momy(k,i,j  ) )
       call CHECK( __LINE__, momy(k,i,j-1) )
<% (nh+1).times do |k| -%>
       call CHECK( __LINE__, val(k<%=-k-1%>,i,j) )
       call CHECK( __LINE__, val(k<%=k%>,i,j) )
<% end -%>
#endif
<%= zj_xyw_level.call("k", order, !twod, "       ") %>
    enddo
    enddo
    enddo
    !$omp end do nowait
#ifdef DEBUG
    k = IUNDEF; i = IUNDEF; j = IUNDEF
#endif

    !$omp do OMP_SCHEDULE_ collapse(2)
    !$acc kernels async
    !$acc loop independent collapse(2)
    do j = JJS, JJE
    do i = IIS, IIE
#ifdef DEBUG
<% if nh >= 1 -%>
<%- 0.upto(2*nh-1+order%2) do |k| -%>
       call CHECK( __LINE__, val(KS<%=k%>,i,j) )
<%- end -%>
<%- (2*nh-1+order%2).downto(0) do |k| -%>
       call CHECK( __LINE__, val(KE<%=-k-1%>,i,j) )
<%- end -%>
<% end -%>
#endif
       ! The fluxes at KS and KE are set last: the boundary levels overlap them when KMAX is small.
<% nh.times do |k| -%>
       ! k = KS<%=k+1%>
<%= zj_xyw_level.call("KS"+(k+1), order_lo(order, nh, k), !twod, "       ") %>
<% end -%>
<% (nh-1).downto(0) do |k| -%>
<%   if k == nh-1 -%>
       ! this level is left to the bottom block when the blocks overlap (KMAX < <%=format("%d",2*nh+2)%>)
       if ( KE<%=-(nh+1)%> > KS<%=nh-1%> ) then
          ! k = KE<%=-(k+1)%>
<%= zj_xyw_level.call("KE"-(k+1), order_up(order, nh, k), !twod, "          ") %>
       end if
<%   else -%>
       ! k = KE<%=-(k+1)%>
<%= zj_xyw_level.call("KE"-(k+1), order_up(order, nh, k), !twod, "       ") %>
<%   end -%>
<% end -%>
       ! k = KS and KE: as ATMOS_DYN_FVM_fluxZ_XYW_<%=@scheme%> and ATMOS_DYN_FVM_fluxJ13_XYW_<%=@scheme%>
       if ( KE - KS >= 2 ) then
#ifdef DEBUG
          call CHECK( __LINE__, momz(KS  ,i,j) )
          call CHECK( __LINE__, momz(KE-1,i,j) )
          call CHECK( __LINE__, val(KS  ,i,j) )
          call CHECK( __LINE__, val(KS+1,i,j) )
          call CHECK( __LINE__, val(KE-1,i,j) )
          call CHECK( __LINE__, val(KE-2,i,j) )
#endif
          fv = <%= face_bnd(order, false) %>
          vel = 0.5_RP * momz(KS,i,j) / DENS(KS,i,j)
          flux(KS-1,i,j) = J33G * vel * fv ! k = KS
<% unless twod -%>
          vel = ( cl1 * J13G(KS  ,i,j) * <%= interp("momx", "UYZ", "XYZ", "KS") %> &
                + cl2 * J13G(KS+1,i,j) * <%= interp("momx", "UYZ", "XYZ", "KS+1") %> &
                + cl3 * J13G(KS+2,i,j) * <%= interp("momx", "UYZ", "XYZ", "KS+2") %> ) &
              / DENS(KS,i,j)
          fluxJ13(KS-1,i,j) = vel * MAPF(i,j,1) * fv
<% end -%>
          vel = ( cl1 * J23G(KS  ,i,j) * <%= interp("momy", "XVZ", "XYZ", "KS") %> &
                + cl2 * J23G(KS+1,i,j) * <%= interp("momy", "XVZ", "XYZ", "KS+1") %> &
                + cl3 * J23G(KS+2,i,j) * <%= interp("momy", "XVZ", "XYZ", "KS+2") %> ) &
              / DENS(KS,i,j)
          fluxJ23(KS-1,i,j) = vel * MAPF(i,j,2) * fv
          fv = <%= face_bnd(order, true) %>
          vel = 0.5_RP * momz(KE-1,i,j) / DENS(KE,i,j)
          flux(KE-1,i,j) = J33G * vel * fv ! k = KE
<% unless twod -%>
          vel = ( cu1 * J13G(KE  ,i,j) * <%= interp("momx", "UYZ", "XYZ", "KE") %> &
                + cu2 * J13G(KE-1,i,j) * <%= interp("momx", "UYZ", "XYZ", "KE-1") %> &
                + cu3 * J13G(KE-2,i,j) * <%= interp("momx", "UYZ", "XYZ", "KE-2") %> ) &
              / DENS(KE,i,j)
          fluxJ13(KE-1,i,j) = vel * MAPF(i,j,1) * fv
<% end -%>
          vel = ( cu1 * J23G(KE  ,i,j) * <%= interp("momy", "XVZ", "XYZ", "KE") %> &
                + cu2 * J23G(KE-1,i,j) * <%= interp("momy", "XVZ", "XYZ", "KE-1") %> &
                + cu3 * J23G(KE-2,i,j) * <%= interp("momy", "XVZ", "XYZ", "KE-2") %> ) &
              / DENS(KE,i,j)
          fluxJ23(KE-1,i,j) = vel * MAPF(i,j,2) * fv
       else
          flux   (KS-1,i,j) = 0.0_RP ! k = KS
          flux   (KE-1,i,j) = 0.0_RP ! k = KE
<% unless twod -%>
          fluxJ13(KS-1,i,j) = 0.0_RP
          fluxJ13(KE-1,i,j) = 0.0_RP
<% end -%>
          fluxJ23(KS-1,i,j) = 0.0_RP
          fluxJ23(KE-1,i,j) = 0.0_RP
       end if
       flux(KE  ,i,j) = 0.0_RP ! k = KE+1
    enddo
    enddo
    !$acc end kernels
    !$omp end do nowait

<% end -%>
    end if

    !$acc end data

    !$omp end parallel

    return
  end subroutine ATMOS_DYN_FVM_fluxZJ_XYW_<%=@scheme%>


<% [
     ["X", "UY", 1, 0],
     ["Y", "XV", 0, 1]
   ].each do |dir, xyz, i, j|
  scalars_xyw = {}
  mom_xyw = interp("mom", xyz+"Z", xyz+"W", "k", "i", "j", scalars_xyw)
  dens_xyw = interp("DENS", "XYZ", xyz+"W", "k", "i", "j", scalars_xyw)
%>
  !-----------------------------------------------------------------------------
  !> calculation <%=dir%>-flux at XYW
  subroutine ATMOS_DYN_FVM_flux<%=dir%>_XYW_<%=@scheme%>( &
       flux,              &
       mom, val, DENS,    &
       GSQRT, RMAPF,      &
       num_diff,          &
       CDZ, TwoD,         &
       IIS, IIE, JJS, JJE )
    implicit none

    real(RP), intent(inout) :: flux    (KA,IA,JA)
    real(RP), intent(in)  :: mom     (KA,IA,JA)
    real(RP), intent(in)  :: val     (KA,IA,JA)
    real(RP), intent(in)  :: DENS    (KA,IA,JA)
    real(RP), intent(in)  :: GSQRT   (KA,IA,JA)
    real(RP), intent(in)  :: RMAPF   (   IA,JA,2) !< 1 / map factor
    real(RP), intent(in)  :: num_diff(KA,IA,JA)
    real(RP), intent(in)  :: CDZ     (KA)
    logical,  intent(in)  :: TwoD
    integer,  intent(in)  :: IIS, IIE, JJS, JJE

    real(RP) :: vel
<%= f2h_decls(scalars_xyw) %>
    integer  :: k, i, j
    !---------------------------------------------------------------------------

    !$omp parallel default(none) private(i,j,k,vel) &
<%= f2h_privates(scalars_xyw) %>
    !$omp shared(JJS,JJE,IIS,IIE,KS,KE,mom,val,DENS,flux,GSQRT,RMAPF,num_diff) &
    !$omp shared(CDZ)

    !$acc data copy(flux) copyin(mom, val, DENS, GSQRT, RMAPF, num_diff, CDZ)

<%- if fuse -%>
#ifdef _OPENACC
    ! The flux at KE is selected with merge() in the kernel for the inner levels
    ! (see fluxZ_XYZ). The values in the halo are read but not used.
    !$acc parallel loop collapse(3) async
    do j = JJS<%=-j%>, JJE
    do i = IIS<%=-i%>, IIE
    do k = KS, KE
<%= f2h_assigns(scalars_xyw, mom_xyw, dens_xyw) %>
       vel = <%= mom_xyw %> &
           / <%= dens_xyw %>
       flux(k,i,j) = merge( GSQRT(k,i,j) * RMAPF(i,j,<%=i*2+j%>) * vel &
                   * ( <%= flux("vel", order, i+2*j) %> ) <%= num_diff() %>, &
                            0.0_RP, k <= KE-1 )
    enddo
    enddo
    enddo
#else
<%- end -%>
    !$omp do OMP_SCHEDULE_ collapse(2)
    !$acc parallel loop collapse(3) async
    do j = JJS<%=-j%>, JJE
    do i = IIS<%=-i%>, IIE
    do k = KS, KE-1
#ifdef DEBUG
       call CHECK( __LINE__, mom(k  ,i,j) )
       call CHECK( __LINE__, mom(k+1,i,j) )
<% (nh+1).times do |n| %>
       call CHECK( __LINE__, val(k,i<%=-n*i%>,j<%=-n*j%>) )
       call CHECK( __LINE__, val(k,i<%= (n+1)*i%>,j<%= (n+1)*j%>) )
<% end %>
#endif
<%= f2h_assigns(scalars_xyw, mom_xyw, dens_xyw) %>
       vel = <%= mom_xyw %> &
           / <%= dens_xyw %>
       flux(k,i,j) = GSQRT(k,i,j) * RMAPF(i,j,<%=i*2+j%>) * vel &
                   * ( <%= flux("vel", order, i+2*j) %> ) <%= num_diff() %>
    enddo
    enddo
    enddo
    !$omp end do nowait
#ifdef DEBUG
    k = IUNDEF; i = IUNDEF; j = IUNDEF
#endif

    !$omp do OMP_SCHEDULE_ collapse(2)
    !$acc kernels async
    do j = JJS<%=-j%>, JJE
    do i = IIS<%=-i%>, IIE
       flux(KE,i,j) = 0.0_RP
    enddo
    enddo
    !$acc end kernels
    !$omp end do nowait
<%- if fuse -%>
#endif
<%- end -%>

    !$acc end data

    !$omp end parallel
#ifdef DEBUG
    k = IUNDEF; i = IUNDEF; j = IUNDEF
#endif

    return
  end subroutine ATMOS_DYN_FVM_flux<%=dir%>_XYW_<%=@scheme%>
<% end # X Y loop %>

<% [
     ["UY", 1, 0],
     ["XV", 0, 1],
   ].each do |uv, i, j|
  scalars_z = {}
  mom_xyw_k = nil
  dens_xyw_k = nil
  bnd_xyw = []
  if i == 1
    mom_xyw_k = interp("mom", "XYW", "XYW", "k", "i", "j", scalars_z)
    dens_xyw_k = interp("DENS", "XYZ", "XYW", "k", "i", "j", scalars_z)
    nh.times do |kk|
      bnd_xyw << [
        kk,
        interp("mom", "XYW", "XYW", "KS"+kk, "i", "j", scalars_z),
        interp("DENS", "XYZ", "XYW", "KS"+kk, "i", "j", scalars_z),
        interp("mom", "XYW", "XYW", "KE"-(kk+1), "i", "j", scalars_z),
        interp("DENS", "XYZ", "XYW", "KE"-(kk+1), "i", "j", scalars_z)
      ]
    end
  end
  mom_uvw_k = interp("mom", "XYW", uv+"W", "k", "i", "j", scalars_z)
  dens_uvw_k = interp("DENS", "XYZ", uv+"W", "k", "i", "j", scalars_z)
  bnd_uvw = []
  nh.times do |kk|
    bnd_uvw << [
      kk,
      interp("mom", "XYW", uv+"W", "KS"+kk, "i", "j", scalars_z),
      interp("DENS", "XYZ", uv+"W", "KS"+kk, "i", "j", scalars_z),
      interp("mom", "XYW", uv+"W", "KE"-(kk+1), "i", "j", scalars_z),
      interp("DENS", "XYZ", uv+"W", "KE"-(kk+1), "i", "j", scalars_z)
    ]
  end
%>
  !-----------------------------------------------------------------------------
  !> calculation z-flux at <%=uv%>
  subroutine ATMOS_DYN_FVM_fluxZ_<%=uv%>Z_<%=@scheme%>( &
       flux,              &
       mom, val, DENS,    &
       GSQRT, J33G,       &
       num_diff,          &
       CDZ, TwoD,         &
       IIS, IIE, JJS, JJE )
    implicit none

    real(RP), intent(inout) :: flux    (KA,IA,JA)
    real(RP), intent(in)  :: mom     (KA,IA,JA)
    real(RP), intent(in)  :: val     (KA,IA,JA)
    real(RP), intent(in)  :: DENS    (KA,IA,JA)
    real(RP), intent(in)  :: GSQRT   (KA,IA,JA)
    real(RP), intent(in)  :: J33G
    real(RP), intent(in)  :: num_diff(KA,IA,JA)
    real(RP), intent(in)  :: CDZ     (KA)
    logical,  intent(in)  :: TwoD
    integer,  intent(in)  :: IIS, IIE, JJS, JJE

    real(RP) :: vel
<%- if fuse_lu -%>
#ifdef _OPENACC
    real(RP) :: flo, fup, fin
#endif
<%- end -%>
<%= f2h_decls(scalars_z) %>
    integer  :: k, i, j
    !---------------------------------------------------------------------------

    !$omp parallel default(none) private(i,j,k,vel) &
<%= f2h_privates(scalars_z) %>
    !$omp shared(JJS,JJE,IIS,IIE,KS,KE,mom,val,DENS,flux,J33G,GSQRT,num_diff) &
    !$omp shared(CDZ,TwoD)

    !$acc data copy(flux) copyin(mom, val, DENS, GSQRT, num_diff, CDZ)

<% if i==1 %>
    if ( TwoD ) then

    !$omp do OMP_SCHEDULE_
    !$acc kernels async
    do j = JJS, JJE
    do k = KS<%=nh%>, KE<%=-nh-1%>
       i = IIS
#ifdef DEBUG
       call CHECK( __LINE__, mom(k,i,j) )
<% (nh+1).times do |k| %>
       call CHECK( __LINE__, val(k<%=-k%>,i,j) )
       call CHECK( __LINE__, val(k<%=k+1%>,i,j) )
<% end %>
#endif
<%= f2h_assigns(scalars_z, mom_xyw_k, dens_xyw_k) %>
       vel = <%= mom_xyw_k %> &
           / <%= dens_xyw_k %>
       flux(k,i,j) = J33G * vel &
                   * ( <%= flux("vel", order, 0) %> ) <%= num_diff() %>
    enddo
    enddo
    !$acc end kernels
    !$omp end do nowait
#ifdef DEBUG
    k = IUNDEF; i = IUNDEF; j = IUNDEF
#endif

    !$omp do OMP_SCHEDULE_
    !$acc kernels async
    do j = JJS, JJE
       i = IIS
#ifdef DEBUG
<% nh.times do |k| %>
       call CHECK( __LINE__, mom(KS<%=k%>,i  ,j) )
       call CHECK( __LINE__, val(KS<%=k*2+1%>,i,j) )
       call CHECK( __LINE__, val(KS<%=k*2%>,i,j) )
<% end %>
#endif
       ! The boundary condition is qflx_hi + qflxJ13 + qfluxJ23 = 0 at KS-1.
       ! The flux at KS-1 can be non-zero.
       ! To reduce calculations, all the fluxes are set to zero.
       flux(KS-1,i,j) = 0.0_RP
<% bnd_xyw.each do |kk, mks, dks, mke, dke| %>
<%= f2h_assigns(scalars_z, mks, dks) %>
       vel = <%= mks %> &
           / <%= dks %>
       flux(KS<%=kk%>,i,j) = J33G * vel &
                   * ( <%= flux("vel", [[order-(nh-kk)*2,[order,2].min].max,[order-(nh-kk-1)*2,[order,2].min].max], 0, "KS"+kk) %> ) <%= num_diff("KS"+kk) %>
<%= f2h_assigns(scalars_z, mke, dke) %>
       vel = <%= mke %> &
           / <%= dke %>
       flux(KE<%=-kk-1%>,i,j) = J33G * vel &
                   * ( <%= flux("vel", [[order-(nh-kk-1)*2,[order,2].min].max,[order-(nh-kk)*2,[order,2].min].max], 0, "KE"-(kk+1)) %> ) <%= num_diff("KE"-(kk+1)) %>
<% end %>
       flux(KE,i,j) = 0.0_RP
    enddo
    !$acc end kernels
    !$omp end do nowait

    else

<% end %>
<%- if fuse_lu -%>
#ifdef _OPENACC
    ! The fluxes at the boundary levels are selected with merge() in the kernel for
    ! the inner levels (see fluxZ_XYZ).
    ! The values in the halo are read but not used.
    !$acc parallel loop collapse(3) async
    do j = JJS, JJE
    do i = IIS, IIE
    do k = KS-1, KE
<%= f2h_assigns(scalars_z, mom_uvw_k, dens_uvw_k) %>
       vel = <%= mom_uvw_k %> &
           / <%= dens_uvw_k %>
       flo = <%= flux_bnd("vel", order_lo(order, nh), 0) %>
       fup = <%= flux_bnd("vel", order_up(order, nh), 0) %>
       fin = <%= flux("vel", order, 0) %>
       ! The boundary condition is qflx_hi + qflxJ13 + qfluxJ23 = 0 at KS-1.
       ! The flux at KS-1 can be non-zero.
       ! To reduce calculations, all the fluxes are set to zero.
       flux(k,i,j) = merge( J33G * vel &
                   * ( merge( fup, merge( flo, fin, k == KS ), k == KE-1 ) ) <%= num_diff() %>, &
                            0.0_RP, KS <= k .and. k <= KE-1 )
    enddo
    enddo
    enddo
#else
<%- end -%>
    !$omp do OMP_SCHEDULE_ collapse(2)
    !$acc parallel loop collapse(3) async
    do j = JJS, JJE
    do i = IIS, IIE
    do k = KS<%=nh%>, KE<%=-nh-1%>
#ifdef DEBUG
       call CHECK( __LINE__, mom(k,i,j) )
       call CHECK( __LINE__, mom(k,i<%=i%>,j<%=j%>) )
<% (nh+1).times do |k| %>
       call CHECK( __LINE__, val(k<%=-k%>,i,j) )
       call CHECK( __LINE__, val(k<%=k+1%>,i,j) )
<% end %>
#endif
<%= f2h_assigns(scalars_z, mom_uvw_k, dens_uvw_k) %>
       vel = <%= mom_uvw_k %> &
           / <%= dens_uvw_k %>
       flux(k,i,j) = J33G * vel &
                   * ( <%= flux("vel", order, 0) %> ) <%= num_diff() %>
    enddo
    enddo
    enddo
    !$omp end do nowait
#ifdef DEBUG
    k = IUNDEF; i = IUNDEF; j = IUNDEF
#endif

    !$omp do OMP_SCHEDULE_ collapse(2)
    !$acc kernels async
    do j = JJS, JJE
    do i = IIS, IIE
#ifdef DEBUG
<% nh.times do |k| %>
       call CHECK( __LINE__, mom(KS<%=k%>,i  ,j) )
       call CHECK( __LINE__, mom(KS<%=k%>,i<%=i%>,j<%=j%>) )
       call CHECK( __LINE__, val(KS<%=k*2+1%>,i,j) )
       call CHECK( __LINE__, val(KS<%=k*2%>,i,j) )
<% end %>
#endif
       ! The boundary condition is qflx_hi + qflxJ13 + qfluxJ23 = 0 at KS-1.
       ! The flux at KS-1 can be non-zero.
       ! To reduce calculations, all the fluxes are set to zero.
       flux(KS-1,i,j) = 0.0_RP
<% bnd_uvw.each do |kk, mks, dks, mke, dke| %>
<%= f2h_assigns(scalars_z, mks, dks) %>
       vel = <%= mks %> &
           / <%= dks %>
       flux(KS<%=kk%>,i,j) = J33G * vel &
                   * ( <%= flux("vel", [[order-(nh-kk)*2,[order,2].min].max,[order-(nh-kk-1)*2,[order,2].min].max], 0, "KS"+kk) %> ) <%= num_diff("KS"+kk) %>
<%= f2h_assigns(scalars_z, mke, dke) %>
       vel = <%= mke %> &
           / <%= dke %>
       flux(KE<%=-kk-1%>,i,j) = J33G * vel &
                   * ( <%= flux("vel", [[order-(nh-kk-1)*2,[order,2].min].max,[order-(nh-kk)*2,[order,2].min].max], 0, "KE"-(kk+1)) %> ) <%= num_diff("KE"-(kk+1)) %>
<% end %>
       flux(KE,i,j) = 0.0_RP
    enddo
    enddo
    !$acc end kernels
    !$omp end do nowait
<%- if fuse_lu -%>
#endif
<%- end -%>
<% if i==1 %>
    end if
<% end %>

    !$acc end data

    !$omp end parallel
#ifdef DEBUG
    k = IUNDEF; i = IUNDEF; j = IUNDEF
#endif

    return
  end subroutine ATMOS_DYN_FVM_fluxZ_<%=uv%>Z_<%=@scheme%>
<% [
     ["J13", "UYZ", 2],
     ["J23", "XVZ", 1]
   ].each do |dir, xyz, im|
  scalars_j = {}
  mom_xyw_k = nil
  dens_xyw_k = nil
  bnd_xyw = []
  if i == 1 && im == 1
    mom_xyw_k = interp("mom", xyz, "XYW", "k", "i", "j", scalars_j)
    dens_xyw_k = interp("DENS", "XYZ", "XYW", "k", "i", "j", scalars_j)
    nh.times do |kk|
      bnd_xyw << [
        kk,
        interp("mom", xyz, "XYW", "KS"+kk, "i", "j", scalars_j),
        interp("DENS", "XYZ", "XYW", "KS"+kk, "i", "j", scalars_j),
        interp("mom", xyz, "XYW", "KE"-(kk+1), "i", "j", scalars_j),
        interp("DENS", "XYZ", "XYW", "KE"-(kk+1), "i", "j", scalars_j)
      ]
    end
  end
  mom_uvw_k = interp("mom", xyz, uv+"W", "k", "i", "j", scalars_j)
  dens_uvw_k = interp("DENS", "XYZ", uv+"W", "k", "i", "j", scalars_j)
  bnd_uvw = []
  nh.times do |kk|
    bnd_uvw << [
      kk,
      interp("mom", xyz, uv+"W", "KS"+kk, "i", "j", scalars_j),
      interp("DENS", "XYZ", uv+"W", "KS"+kk, "i", "j", scalars_j),
      interp("mom", xyz, uv+"W", "KE"-(kk+1), "i", "j", scalars_j),
      interp("DENS", "XYZ", uv+"W", "KE"-(kk+1), "i", "j", scalars_j)
    ]
  end
  # the metric is used only for the F2H weights here, so take the precomputed weights instead
  scalars_j.each_value { |info| info[:expr] = info[:expr].sub(/F2H\(([^,]+),[^)]*\)/) { "F2HW(#{$1},i,j)" } }
%>
  !-----------------------------------------------------------------------------
  !> calculation <%=dir%>-flux at <%=uv%>Z
  subroutine ATMOS_DYN_FVM_flux<%=dir%>_<%=uv%>Z_<%=@scheme%>( &
       flux,              &
       mom, val, DENS,    &
       F2HW, <%=dir%>G, RMAPF, &
       CDZ, TwoD,         &
       IIS, IIE, JJS, JJE )
    implicit none

    real(RP), intent(inout) :: flux    (KA,IA,JA)
    real(RP), intent(in)  :: mom     (KA,IA,JA)
    real(RP), intent(in)  :: val     (KA,IA,JA)
    real(RP), intent(in)  :: DENS    (KA,IA,JA)
    real(RP), intent(in)  :: F2HW    (KA,IA,JA) !< F2H weight of the full level k+1
    real(RP), intent(in)  :: <%=dir%>G    (KA,IA,JA)
    real(RP), intent(in)  :: RMAPF   (   IA,JA,2) !< 1 / map factor
    real(RP), intent(in)  :: CDZ     (KA)
    logical,  intent(in)  :: TwoD
    integer,  intent(in)  :: IIS, IIE, JJS, JJE

    real(RP) :: vel
<%- if fuse_lu -%>
#ifdef _OPENACC
    real(RP) :: flo, fup, fin
#endif
<%- end -%>
<%= f2h_decls(scalars_j) %>
    integer  :: k, i, j
    !---------------------------------------------------------------------------

    !$omp parallel default(none) private(i,j,k,vel) &
<%= f2h_privates(scalars_j) %>
    !$omp shared(JJS,JJE,IIS,IIE,KS,KE,mom,val,DENS,flux,<%=dir%>G,RMAPF) &
    !$omp shared(F2HW,CDZ,TwoD)

    !$acc data copy(flux) copyin(mom, val, DENS, F2HW, <%=dir%>G, RMAPF, CDZ)

<% if i==1 && im==1 %>
    if ( TwoD ) then

    !$omp do OMP_SCHEDULE_
    !$acc kernels async
    do j = JJS, JJE
    do k = KS<%=nh%>, KE<%=-nh-1%>
       i = IIS
<%= f2h_assigns(scalars_j, mom_xyw_k, dens_xyw_k) %>
       vel = <%= mom_xyw_k %> &
           / <%= dens_xyw_k %>
       vel = vel * <%=dir%>G(k,i,j)
       flux(k,i,j) = vel * ( <%= flux("vel", order, 0) %> )
    enddo
    enddo
    !$acc end kernels
    !$omp end do nowait

    !$omp do OMP_SCHEDULE_
    !$acc kernels async
    do j = JJS, JJE
       i = IIS
       ! The boundary condition is qflx_hi + qflxJ13 + qfluxJ23 = 0 at KS-1.
       ! The flux at KS-1 can be non-zero.
       ! To reduce calculations, all the fluxes are set to zero.
       flux(KS-1,i,j) = 0.0_RP
<% bnd_xyw.each do |kk, mks, dks, mke, dke| %>
<%= f2h_assigns(scalars_j, mks, dks) %>
       vel = <%= mks %> &
           / <%= dks %>
       vel = vel * <%=dir%>G(KS<%=kk%>,i,j)
       flux(KS<%=kk%>,i,j) = vel * RMAPF(i,j,<%=im%>) &
                   * ( <%= flux("vel", [[order-(nh-kk)*2,[order,2].min].max,[order-(nh-kk-1)*2,[order,2].min].max], 0, "KS"+kk) %> )

<%= f2h_assigns(scalars_j, mke, dke) %>
       vel = <%= mke %> &
           / <%= dke %>
       vel = vel * <%=dir%>G(KE<%=-kk-1%>,i,j)
       flux(KE<%=-kk-1%>,i,j) = vel * RMAPF(i,j,<%=im%>) &
                   * ( <%= flux("vel", [[order-(nh-kk-1)*2,[order,2].min].max,[order-(nh-kk)*2,[order,2].min].max], 0, "KE"-(kk+1)) %> )
<% end %>
       flux(KE  ,i,j) = 0.0_RP
    enddo
    !$acc end kernels
    !$omp end do nowait

    else
<% end %>

<%- if fuse_lu -%>
#ifdef _OPENACC
    ! The fluxes at the boundary levels are selected with merge() in the kernel for
    ! the inner levels (see fluxZ_XYZ).
    ! The values in the halo are read but not used.
    !$acc parallel loop collapse(3) async
    do j = JJS, JJE
    do i = IIS, IIE
    do k = KS-1, KE
<%= f2h_assigns(scalars_j, mom_uvw_k, dens_uvw_k) %>
       vel = <%= mom_uvw_k %> &
           / <%= dens_uvw_k %>
       vel = vel * <%=dir%>G(k,i,j)
       flo = <%= flux_bnd("vel", order_lo(order, nh), 0) %>
       fup = <%= flux_bnd("vel", order_up(order, nh), 0) %>
       fin = <%= flux("vel", order, 0) %>
       ! The boundary condition is qflx_hi + qflxJ13 + qfluxJ23 = 0 at KS-1.
       ! The flux at KS-1 can be non-zero.
       ! To reduce calculations, all the fluxes are set to zero.
       flux(k,i,j) = merge( vel * RMAPF(i,j,<%=im%>) &
                   * ( merge( fup, merge( flo, fin, k == KS ), k == KE-1 ) ), &
                            0.0_RP, KS <= k .and. k <= KE-1 )
    enddo
    enddo
    enddo
#else
<%- end -%>
    !$omp do OMP_SCHEDULE_ collapse(2)
    !$acc parallel loop collapse(3) async
    do j = JJS, JJE
    do i = IIS, IIE
    do k = KS<%=nh%>, KE<%=-nh-1%>
<%= f2h_assigns(scalars_j, mom_uvw_k, dens_uvw_k) %>
       vel = <%= mom_uvw_k %> &
           / <%= dens_uvw_k %>
       vel = vel * <%=dir%>G(k,i,j)
       flux(k,i,j) = vel * RMAPF(i,j,<%=im%>) &
                   * ( <%= flux("vel", order, 0) %> )
    enddo
    enddo
    enddo
    !$omp end do nowait

    !$omp do OMP_SCHEDULE_ collapse(2)
    !$acc kernels async
    do j = JJS, JJE
    do i = IIS, IIE
       ! The boundary condition is qflx_hi + qflxJ13 + qfluxJ23 = 0 at KS-1.
       ! The flux at KS-1 can be non-zero.
       ! To reduce calculations, all the fluxes are set to zero.
       flux(KS-1,i,j) = 0.0_RP
<% bnd_uvw.each do |kk, mks, dks, mke, dke| %>
<%= f2h_assigns(scalars_j, mks, dks) %>
       vel = <%= mks %> &
           / <%= dks %>
       vel = vel * <%=dir%>G(KS<%=kk%>,i,j)
       flux(KS<%=kk%>,i,j) = vel * RMAPF(i,j,<%=im%>) &
                   * ( <%= flux("vel", [[order-(nh-kk)*2,[order,2].min].max,[order-(nh-kk-1)*2,[order,2].min].max], 0, "KS"+kk) %> )

<%= f2h_assigns(scalars_j, mke, dke) %>
       vel = <%= mke %> &
           / <%= dke %>
       vel = vel * <%=dir%>G(KE<%=-kk-1%>,i,j)
       flux(KE<%=-kk-1%>,i,j) = vel * RMAPF(i,j,<%=im%>) &
                   * ( <%= flux("vel", [[order-(nh-kk-1)*2,[order,2].min].max,[order-(nh-kk)*2,[order,2].min].max], 0, "KE"-(kk+1)) %> )
<% end %>
       flux(KE  ,i,j) = 0.0_RP
    enddo
    enddo
    !$acc end kernels
    !$omp end do nowait
<%- if fuse_lu -%>
#endif
<%- end -%>

<% if i==1 && im==1 %>
    end if
<% end %>

    !$acc end data

    !$omp end parallel
    return
  end subroutine ATMOS_DYN_FVM_flux<%=dir%>_<%=uv%>Z_<%=@scheme%>
<% end # J13 J23 loop %>
<%
  # F2H scalars of the part of J33G (zs: the weights CDZ*GSQRT, as in fluxZ) and of the metric parts
  # (js: F2HW, as in fluxJ13 and fluxJ23), which have other names (prefix fjh)
  zs = {}
  js = {}
  # velocities of the parts at the half level k; twod: without the part of J13G (and, for UYZ, at XYW as fluxZ_UYZ in 2-D)
  zj_uvz_exprs = lambda do |k, twod|
    dst = ( twod && i == 1 ) ? "XYW" : uv+"W"
    e = {}
    e[:mz] = interp("momz", "XYW", dst, k, "i", "j", zs)
    e[:dz] = interp("DENS", "XYZ", dst, k, "i", "j", zs)
    @f2h_prefix = "fjh"
    e[:mx] = twod ? nil : interp("momx", "UYZ", dst, k, "i", "j", js)
    e[:my] = interp("momy", "XVZ", dst, k, "i", "j", js)
    e[:dj] = interp("DENS", "XYZ", dst, k, "i", "j", js)
    @f2h_prefix = nil
    e
  end
  zj_k = {}
  [false, true].each do |twod|
    (["k"] + (0...nh).map{|kk| ["KS"+kk, "KE"-(kk+1)]}.flatten).each do |k|
      zj_k[[k, twod]] = zj_uvz_exprs.call(k, twod)
    end
  end
  f2h_raw!(zs)
  js.each_value { |info| info[:expr] = info[:expr].sub(/F2H\(([^,]+),[^)]*\)/) { "F2HW(#{$1},i,j)" } }
  # velocities of the parts and the total velocity at the half level k
  zj_uvz_vel = lambda do |k, twod, ind|
    e = zj_k[[k, twod]]
    s = []
    a = f2h_assigns(zs, e[:mz], e[:dz])
    s << a.lines.map(&:strip).join("\n") unless a.empty?
    a = f2h_assigns(js, *[e[:mx], e[:my], e[:dj]].compact)
    s << a.lines.map(&:strip).join("\n") unless a.empty?
    s << "vz = #{vel_div(e[:mz], e[:dz], zs)}"
    s << "vz = J33G * vz"
    s << "dj = #{e[:dj]}"
    unless twod
      s << "vx = #{e[:mx]} &"
      s << "   / dj"
      s << "vx = vx * J13G(#{k},i,j)"
      s << "vx = vx * MAPF(i,j,1)"
    end
    s << "vy = #{e[:my]} &"
    s << "   / dj"
    s << "vy = vy * J23G(#{k},i,j)"
    s << "vy = vy * MAPF(i,j,2)"
    s << ( twod ? "vt = vz + vy" : "vt = vz + vx + vy" ) if order.odd? # the face value of the central schemes does not depend on it
    s.join("\n").gsub(/^/, ind).gsub(/^\s+$/, "")
  end
  # DEBUG checks of the points of momx and momy read for the velocities of the metric parts at the half levels ks
  zj_uvz_mom_checks = lambda do |ks, twod, ind|
    refs = []
    ks.each do |k|
      e = zj_k[[k, twod]]
      [e[:mx], e[:my]].compact.each { |x| refs.concat( x.scan(/mom[xy]\([^()]*\)/) ) }
    end
    refs.uniq.map { |r| "#{ind}call CHECK( __LINE__, #{r} )" }.join("\n")
  end
  # fluxes of the parts at the half level k with the scheme ord
  zj_uvz_level = lambda do |k, ord, twod, ind|
    s = []
    s << "fv = #{flux("vt", ord, 0, k)}"
    s << "flux(#{k},i,j) = vz * fv #{num_diff(k)}".rstrip
    s << "fluxJ13(#{k},i,j) = vx * fv" unless twod
    s << "fluxJ23(#{k},i,j) = vy * fv"
    zj_uvz_vel.call(k, twod, ind) + "\n" + s.join("\n").gsub(/^/, ind)
  end
-%>
  !-----------------------------------------------------------------------------
  !> calculation of the vertical flux at <%=uv%>Z: the three parts with one face value
  !!
  !! The three parts of the vertical flux, those of ATMOS_DYN_FVM_fluxZ_<%=uv%>Z_<%=@scheme%> (flux),
  !! ATMOS_DYN_FVM_fluxJ13_<%=uv%>Z_<%=@scheme%> (fluxJ13) and ATMOS_DYN_FVM_fluxJ23_<%=uv%>Z_<%=@scheme%> (fluxJ23), are computed
<% if order.odd? -%>
  !! with one face value, whose upwind side is taken by the sign of the total contravariant vertical velocity
  !! J33G w + m_x J13G u + m_y J23G v, the sum of the velocities that multiply the face value in the three parts
  !! (issue #3754): with GSQRT (the weights of J33G w) and F2HW (those of the metric parts) as passed to the separate routines.
  !! Each part is the flux of the separate routine when its own velocity has the sign of the total one.
<% else -%>
  !! with one face value (issue #3754). With the central scheme the face value does not depend on the velocity,
  !! so the parts are those of the separate routines, except for the rounding.
<% end -%>
  !! With TwoD, the part of J13G is not computed (fluxJ13 is not changed), and momx is not used<% if i == 1 %>;
  !! the velocities are those of the separate routines in 2-D<% end %>.
  subroutine ATMOS_DYN_FVM_fluxZJ_<%=uv%>Z_<%=@scheme%>( &
       flux, fluxJ13, fluxJ23,   &
       momz, momx, momy, val,    &
       DENS, GSQRT, F2HW,        &
       J33G, J13G, J23G, MAPF,   &
       num_diff,                 &
       CDZ, TwoD,                &
       IIS, IIE, JJS, JJE        )
    implicit none

    real(RP), intent(inout) :: flux    (KA,IA,JA)
    real(RP), intent(inout) :: fluxJ13 (KA,IA,JA)
    real(RP), intent(inout) :: fluxJ23 (KA,IA,JA)
    real(RP), intent(in)  :: momz    (KA,IA,JA)
    real(RP), intent(in)  :: momx    (KA,IA,JA)
    real(RP), intent(in)  :: momy    (KA,IA,JA)
    real(RP), intent(in)  :: val     (KA,IA,JA)
    real(RP), intent(in)  :: DENS    (KA,IA,JA)
    real(RP), intent(in)  :: GSQRT   (KA,IA,JA)
    real(RP), intent(in)  :: F2HW    (KA,IA,JA) !< F2H weight of the full level k+1 (metric parts)
    real(RP), intent(in)  :: J33G
    real(RP), intent(in)  :: J13G    (KA,IA,JA)
    real(RP), intent(in)  :: J23G    (KA,IA,JA)
    real(RP), intent(in)  :: MAPF    (   IA,JA,2) !< map factor
    real(RP), intent(in)  :: num_diff(KA,IA,JA)
    real(RP), intent(in)  :: CDZ     (KA)
    logical,  intent(in)  :: TwoD
    integer,  intent(in)  :: IIS, IIE, JJS, JJE

    real(RP) :: vz, vx, vy ! velocities of the parts: J33G w, m_x J13G u, m_y J23G v
<% if order.odd? -%>
    real(RP) :: vt         ! total contravariant vertical velocity
<% end -%>
    real(RP) :: dj         ! density of the metric parts
    real(RP) :: fv         ! face value
<%- if fuse_lu -%>
#ifdef _OPENACC
    real(RP) :: flo, fup, fin
#endif
<%- end -%>
<%= f2h_decls(zs) %>
<%= f2h_decls(js) %>
    integer  :: k, i, j
    !---------------------------------------------------------------------------

    !$omp parallel default(none) private(i,j,k,vz,vx,vy<%= order.odd? ? ",vt" : "" %>,dj,fv) &
<%= f2h_privates(zs) %>
<%= f2h_privates(js) %>
    !$omp shared(JJS,JJE,IIS,IIE,KS,KE,momz,momx,momy,val,DENS,GSQRT,F2HW,J33G,J13G,J23G,MAPF,num_diff) &
    !$omp shared(flux,fluxJ13,fluxJ23,CDZ,TwoD)

    !$acc data copy(flux, fluxJ13, fluxJ23) &
    !$acc      copyin(momz, momx, momy, val, DENS, GSQRT, F2HW, J13G, J23G, MAPF, num_diff, CDZ)

<% [ [false, "if ( .not. TwoD ) then"], [true, "else ! TwoD: without the part of J13G"] ].each do |twod, cond| -%>
    <%= cond %>

<%   if twod && i == 1 -%>
    !$omp do OMP_SCHEDULE_
    !$acc kernels async
    !$acc loop independent collapse(2) private(i)
    do j = JJS, JJE
    do k = KS<%=nh%>, max( KE<%=-nh-1%>, KS<%=nh-1%> )
       i = IIS
#ifdef DEBUG
       call CHECK( __LINE__, momz(k,i,j) )
<%= zj_uvz_mom_checks.call(["k"], twod, "       ") %>
<% (nh+1).times do |k| -%>
       call CHECK( __LINE__, val(k<%=-k%>,i,j) )
       call CHECK( __LINE__, val(k<%=k+1%>,i,j) )
<% end -%>
#endif
<%= zj_uvz_level.call("k", order, twod, "       ") %>
    enddo
    enddo
    !$acc end kernels
    !$omp end do nowait
#ifdef DEBUG
    k = IUNDEF; i = IUNDEF; j = IUNDEF
#endif

    !$omp do OMP_SCHEDULE_
    !$acc kernels async
    !$acc loop independent private(i)
    do j = JJS, JJE
       i = IIS
<%   else -%>
<%-    if fuse_lu -%>
#ifdef _OPENACC
    ! The fluxes at the boundary levels are selected with merge() in the kernel for
    ! the inner levels (see fluxZ_XYZ).
    ! The values in the halo are read but not used.
    !$acc parallel loop collapse(3) async
    do j = JJS, JJE
    do i = IIS, IIE
    do k = KS-1, KE
<%= zj_uvz_vel.call("k", twod, "       ") %>
       flo = <%= flux_bnd("vt", order_lo(order, nh), 0) %>
       fup = <%= flux_bnd("vt", order_up(order, nh), 0) %>
       fin = <%= flux("vt", order, 0) %>
       fv = merge( fup, merge( flo, fin, k == KS ), k == KE-1 )
       flux(k,i,j) = merge( vz * fv <%= num_diff() %>, &
                            0.0_RP, KS <= k .and. k <= KE-1 )
<%     unless twod -%>
       fluxJ13(k,i,j) = merge( vx * fv, 0.0_RP, KS <= k .and. k <= KE-1 )
<%     end -%>
       fluxJ23(k,i,j) = merge( vy * fv, 0.0_RP, KS <= k .and. k <= KE-1 )
    enddo
    enddo
    enddo
#else
<%-    end -%>
    !$omp do OMP_SCHEDULE_ collapse(2)
    !$acc parallel loop collapse(3) async
    do j = JJS, JJE
    do i = IIS, IIE
    do k = KS<%=nh%>, max( KE<%=-nh-1%>, KS<%=nh-1%> )
#ifdef DEBUG
       call CHECK( __LINE__, momz(k,i,j) )
       call CHECK( __LINE__, momz(k,i<%=i%>,j<%=j%>) )
<%= zj_uvz_mom_checks.call(["k"], twod, "       ") %>
<% (nh+1).times do |k| -%>
       call CHECK( __LINE__, val(k<%=-k%>,i,j) )
       call CHECK( __LINE__, val(k<%=k+1%>,i,j) )
<% end -%>
#endif
<%= zj_uvz_level.call("k", order, twod, "       ") %>
    enddo
    enddo
    enddo
    !$omp end do nowait
#ifdef DEBUG
    k = IUNDEF; i = IUNDEF; j = IUNDEF
#endif

    !$omp do OMP_SCHEDULE_ collapse(2)
    !$acc kernels async
    !$acc loop independent collapse(2)
    do j = JJS, JJE
    do i = IIS, IIE
<%   end -%>
#ifdef DEBUG
<% nh.times do |k| -%>
       call CHECK( __LINE__, momz(KS<%=k%>,i,j) )
       call CHECK( __LINE__, val(KS<%=k*2+1%>,i,j) )
       call CHECK( __LINE__, val(KS<%=k*2%>,i,j) )
<% end -%>
<% if nh > 0 -%>
<%= zj_uvz_mom_checks.call((0...nh).map{|kk| ["KS"+kk, "KE"-(kk+1)]}.flatten, twod, "       ") %>
<% end -%>
#endif
       ! The boundary condition is qflx_hi + qflxJ13 + qfluxJ23 = 0 at KS-1.
       ! The flux at KS-1 can be non-zero.
       ! To reduce calculations, all the fluxes are set to zero.
       flux   (KS-1,i,j) = 0.0_RP
<%   unless twod -%>
       fluxJ13(KS-1,i,j) = 0.0_RP
<%   end -%>
       fluxJ23(KS-1,i,j) = 0.0_RP
<%   nh.times do |kk| -%>
<%= zj_uvz_level.call("KS"+kk, order_lo(order, nh, kk), twod, "       ") %>
<%= zj_uvz_level.call("KE"-(kk+1), order_up(order, nh, kk), twod, "       ") %>
<%   end -%>
       flux   (KE,i,j) = 0.0_RP
<%   unless twod -%>
       fluxJ13(KE,i,j) = 0.0_RP
<%   end -%>
       fluxJ23(KE,i,j) = 0.0_RP
<%   if twod && i == 1 -%>
    enddo
<%   else -%>
    enddo
    enddo
<%   end -%>
    !$acc end kernels
    !$omp end do nowait
<%-  if fuse_lu && !( twod && i == 1 ) -%>
#endif
<%-  end -%>

<% end -%>
    end if

    !$acc end data

    !$omp end parallel
#ifdef DEBUG
    k = IUNDEF; i = IUNDEF; j = IUNDEF
#endif

    return
  end subroutine ATMOS_DYN_FVM_fluxZJ_<%=uv%>Z_<%=@scheme%>
<% [
     ["X", 1, 0],
     ["Y", 0, 1]
   ].each do |dir, ii, jj|
%>
  !-----------------------------------------------------------------------------
  !> calculation <%=dir%>-flux at <%=uv%>
  subroutine ATMOS_DYN_FVM_flux<%=dir%>_<%=uv%>Z_<%=@scheme%>( &
       flux,              &
       mom, val, DENS,    &
       GSQRT, RMAPF,      &
       num_diff,          &
       CDZ, TwoD,         &
       IIS, IIE, JJS, JJE )
    implicit none

    real(RP), intent(inout) :: flux    (KA,IA,JA)
    real(RP), intent(in)  :: mom     (KA,IA,JA)
    real(RP), intent(in)  :: val     (KA,IA,JA)
    real(RP), intent(in)  :: DENS    (KA,IA,JA)
    real(RP), intent(in)  :: GSQRT   (KA,IA,JA)
    real(RP), intent(in)  :: RMAPF   (   IA,JA,2) !< 1 / map factor
    real(RP), intent(in)  :: num_diff(KA,IA,JA)
    real(RP), intent(in)  :: CDZ     (KA)
    logical,  intent(in)  :: TwoD
    integer,  intent(in)  :: IIS, IIE, JJS, JJE

    real(RP) :: vel
    integer  :: k, i, j
    !---------------------------------------------------------------------------
<% if uv=="UY" && dir=="X" %>
    ! note that x-index is added by -1
<%
     io = 1
   else
     io = 0
   end
   if uv=="XV" && dir=="Y"
%>
    ! note that y-index is added by -1
<%
     jo = 1
   else
     jo = 0
   end

   dst = uv
   if dir=="X"
     dst = dst[0..0]=="X" ? "U"+dst[1..1] : "X"+dst[1..1]
   else # dir=="Y"
     dst = dst[1..1]=="Y" ? dst[0..0]+"V" : dst[0..0]+"Y"
   end
%>

<% if i==1 && jj==1 %>
    if ( TwoD ) then

    !$omp parallel do default(none) private(i,j,k) OMP_SCHEDULE_ &
    !$omp private(vel) &
    !$omp shared(JJS,JJE,IIS,IIE,KS,KE,mom,val,DENS,flux,GSQRT,RMAPF,num_diff,TwoD)
    !$acc kernels async
    do j = JJS<%=-jj+jo%>, JJE<%=jo%>
    do k = KS, KE
       i = IIS
#ifdef DEBUG
       call CHECK( __LINE__, mom(k,i  ,j) )
<% (nh+1).times do |n| %>
       call CHECK( __LINE__, val(k,i<%=-n*ii-io%>,j<%=-n*jj-jo%>) )
       call CHECK( __LINE__, val(k,i<%=(n+1)*ii-io%>,j<%=(n+1)*jj-jo%>) )
<% end %>
#endif
       vel = <%= interp("mom", dir=="X" ? "UYZ" : "XVZ", "XVZ") %> &
           / <%= interp("DENS", "XYZ", "XVZ") %>
       flux(k,i<%=-io%>,j<%=-jo%>) = GSQRT(k,i,j) * RMAPF(i,j,<%=ii*2+jj%>) * vel &
                   * ( <%= flux("vel", order, ii+jj*2, "k", "i"-io, "j"-jo) %> ) <%= num_diff() %>
    enddo
    enddo
    !$acc end kernels
#ifdef DEBUG
    k = IUNDEF; i = IUNDEF; j = IUNDEF
#endif

    else

<% end %>
    !$omp parallel do default(none) private(i,j,k) OMP_SCHEDULE_ collapse(2) &
    !$omp private(vel) &
    !$omp shared(JJS,JJE,IIS,IIE,KS,KE,mom,val,DENS,flux,GSQRT,RMAPF,num_diff)
    !$acc parallel loop collapse(3) async
    do j = JJS<%=-jj+jo%>, JJE<%=jo%>
    do i = IIS<%=-ii+io%>, IIE<%=io%>
    do k = KS, KE
#ifdef DEBUG
       call CHECK( __LINE__, mom(k,i  ,j) )
       call CHECK( __LINE__, mom(k,i<%=-i%>,j<%=-j%>) )
<% (nh+1).times do |n| %>
       call CHECK( __LINE__, val(k,i<%=-n*ii-io%>,j<%=-n*jj-jo%>) )
       call CHECK( __LINE__, val(k,i<%=(n+1)*ii-io%>,j<%=(n+1)*jj-jo%>) )
<% end %>
#endif
       vel = <%= interp("mom", dir=="X" ? "UYZ" : "XVZ", dst+"Z") %> &
           / <%= interp("DENS", "XYZ", dst+"Z") %>
       flux(k,i<%=-io%>,j<%=-jo%>) = GSQRT(k,i,j) * RMAPF(i,j,<%=ii*2+jj%>) * vel &
                   * ( <%= flux("vel", order, ii+jj*2, "k", "i"-io, "j"-jo) %> ) <%= num_diff() %>
    enddo
    enddo
    enddo
#ifdef DEBUG
    k = IUNDEF; i = IUNDEF; j = IUNDEF
#endif

<% if i==1 && jj==1 %>
    end if
<% end %>

    return
  end subroutine ATMOS_DYN_FVM_flux<%=dir%>_<%=uv%>Z_<%=@scheme%>
<% end %>
<%# -- X Y loop ------- %>
<% end %>
<%# -- U V loop ------- %>

  !-----------------------------------------------------------------------------
  !> weights of the face values at the full levels KS and KE in the vertical fluxes of rho*w
  !!
  !! The face value at KS (KE) is extrapolated linearly from the half levels KS and KS+1 (KE-1 and KE-2):
  !! val(KS) + wlo * ( val(KS) - val(KS+1) ), val(KE-1) + wup * ( val(KE-1) - val(KE-2) ).
  subroutine bnd_face_weights( &
       CDZ,     &
       wlo, wup )
    implicit none
    real(RP), intent(in)  :: CDZ(KA)
    real(RP), intent(out) :: wlo, wup

    if ( KE - KS >= 2 ) then
       wlo = 0.5_RP * CDZ(KS) / CDZ(KS+1)
       wup = 0.5_RP * CDZ(KE) / CDZ(KE-1)
    else
       wlo = 0.0_RP
       wup = 0.0_RP
    end if

    return
  end subroutine bnd_face_weights

  !-----------------------------------------------------------------------------
  !> weights of the velocities of the metric parts of the vertical fluxes of rho*w at the full levels KS and KE
  !!
  !! a(KS) - 0.5 * a_b = cl(1) * a(KS) + cl(2) * a(KS+1) + cl(3) * a(KS+2), where a_b, the value at the
  !! boundary face KS-1/2, is extrapolated quadratically (Lagrange) from the full levels KS, KS+1 and KS+2.
  !! The same at the top with cu and the levels KE, KE-1, KE-2 and the face KE+1/2.
  !! For a uniform grid, cl = cu = ( 1, 10, -3 ) / 16.
  !! The extrapolation is quadratic, not linear, so that the error of the total velocity at KS is that of the
  !! velocity at KS+1 of the inner scheme, ( mom(KS) + mom(KS+1) ) / 2, up to the third order: the leading
  !! errors of the fluxes at KS and KS+1 then cancel in the tendency of mom(KS), which converges at the second order.
  subroutine bnd_extrap_weights( &
       CDZ,    &
       cl, cu  )
    implicit none
    real(RP), intent(in)  :: CDZ(KA)
    real(RP), intent(out) :: cl(3), cu(3)

    real(RP) :: d0, d1, d2

    if ( KE - KS >= 2 ) then
       ! positions relative to CZ(KS): the face KS-1/2, and the full levels KS+1 and KS+2
       d0 = - 0.5_RP * CDZ(KS)
       d1 = 0.5_RP * ( CDZ(KS) + CDZ(KS+1) )
       d2 = d1 + 0.5_RP * ( CDZ(KS+1) + CDZ(KS+2) )
       cl(1) = 1.0_RP - 0.5_RP * ( d0 - d1 ) * ( d0 - d2 ) / ( d1 * d2 )
       cl(2) =        - 0.5_RP * d0 * ( d0 - d2 ) / ( d1 * ( d1 - d2 ) )
       cl(3) =        - 0.5_RP * d0 * ( d0 - d1 ) / ( d2 * ( d2 - d1 ) )
       ! positions relative to CZ(KE): the face KE+1/2, and the full levels KE-1 and KE-2
       d0 = 0.5_RP * CDZ(KE)
       d1 = - 0.5_RP * ( CDZ(KE) + CDZ(KE-1) )
       d2 = d1 - 0.5_RP * ( CDZ(KE-1) + CDZ(KE-2) )
       cu(1) = 1.0_RP - 0.5_RP * ( d0 - d1 ) * ( d0 - d2 ) / ( d1 * d2 )
       cu(2) =        - 0.5_RP * d0 * ( d0 - d2 ) / ( d1 * ( d1 - d2 ) )
       cu(3) =        - 0.5_RP * d0 * ( d0 - d1 ) / ( d2 * ( d2 - d1 ) )
    else
       cl(:) = 0.0_RP
       cu(:) = 0.0_RP
    end if

    return
  end subroutine bnd_extrap_weights

<% if @scheme == "ud3Koren1993" %>
  !-----------------------------------------------------------------------------
  !> phi(r) * (v2-v3) of Koren (1993), where r = 2 (v1-v2) / (v2-v3)
  !> phi(r) = max(0, min(r, (1+r)/3, 2)) is multiplied by v2-v3 before it is evaluated,
  !> so that no division is needed. With a division, which calls the slow path of
  !> the IEEE division, the kernels use more registers and are slower
  !> (fluxX_XYZ: 50 -> 40 registers, 628 -> 397 ms per 2700 calls on GB200).
  function phi_dv(v1, v2, v3)
    !$acc routine seq
    implicit none

    real(RP)              :: phi_dv
#ifdef _OPENACC
    real(RP), intent(in), value :: v1
    real(RP), intent(in), value :: v2
    real(RP), intent(in), value :: v3
#else
    real(RP), intent(in) :: v1
    real(RP), intent(in) :: v2
    real(RP), intent(in) :: v3
#endif

    real(RP) :: sw, a, b
    !---------------------------------------------------------------------------

    ! a and b are 2 (v1-v2) and v2-v3 multiplied by the sign of v2-v3, so that b >= 0
    sw = sign( 1.0_RP, v2-v3 )
    a  = sw * 2.0_RP * ( v1-v2 )
    b  = sw * ( v2-v3 )

    phi_dv = sw * max( 0.0_RP, min( a, ( a + b ) * ( 1.0_RP / 3.0_RP ), 2.0_RP * b ) )

  end function phi_dv

  !-----------------------------------------------------------------------------
  !> Koren (1993) flux at the face between v0 and v1, upwinded by the sign of vel
  !> The stencil is selected before phi_dv() is evaluated, so phi_dv() is evaluated once.
  function flux3k_upwind(vel, vn1, v0, v1, v2)
    !$acc routine seq
    implicit none

    real(RP)              :: flux3k_upwind
#ifdef _OPENACC
    real(RP), intent(in), value :: vel
    real(RP), intent(in), value :: vn1
    real(RP), intent(in), value :: v0
    real(RP), intent(in), value :: v1
    real(RP), intent(in), value :: v2
#else
    real(RP), intent(in) :: vel
    real(RP), intent(in) :: vn1
    real(RP), intent(in) :: v0
    real(RP), intent(in) :: v1
    real(RP), intent(in) :: v2
#endif

    real(RP) :: vu, vc, vd
    logical  :: up
    !---------------------------------------------------------------------------

    up = vel >= 0.0_RP
    vu = merge( vn1, v2, up ) ! upwind of vc
    vc = merge( v0,  v1, up ) ! upwind cell
    vd = merge( v1,  v0, up ) ! downwind cell

    flux3k_upwind = vc + 0.5_RP * phi_dv(vd, vc, vu)

  end function flux3k_upwind
<% end %>

