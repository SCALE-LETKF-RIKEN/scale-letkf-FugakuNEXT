  end
  mom_uvw_k = interp("mom", xyz, uv+"W", "k", "i", "j", scalars_j)
  dens_uvw_k = interp("DENS", "XYZ", uv+"W", "k", "i", "j", scalars_j)
  bnd_uvw = []
  nh.times do |kk|
    bnd_uvw << [
      kk,
      interp("mom", xyz, uv+"W", "KS"+kk, "i", "j", scalars_j),
      interp("DENS", "XYZ", uv+"W", "KS"+kk, "i", "j", scalars_j),
      interp("mom", xyz, uv+"W", "KE"-(kk+1), "i", "j", scalars_j),
      interp("DENS", "XYZ", uv+"W", "KE"-(kk+1), "i", "j", scalars_j)
