% # -*- f90 -*-
% # vi: set sw=4 ts=8:
<%
fname ||= ENV["fname"] # for ruby <= 1.8
if /((?:ud|cd)(\d+)(?:[^\d]\w*)?)\.F90/ =~ fname
  @scheme = $1
  order = $2.to_i
  modname = "scale_atmos_dyn_fvm_flux_#{@scheme}"
  nh = (order+1)/2 - 1
  # With OpenACC, the fluxes at the boundary levels are selected with merge() in
  # the kernel for the inner levels, instead of being computed in a separate kernel.
  # The stencils of all the candidates are evaluated at every level, so this is
  # done only for nh == 1, for which the stencils stay inside the halo (KHALO = 2).
  fuse = ( nh == 1 )
  if order >= 2
    def num_diff(k="k",i="i",j="j")
                  "&
                   + GSQRT(#{k},#{i},#{j}) * num_diff(#{k},#{i},#{j})"
    end
  else
    def num_diff(*arg)
      nil
    end
  end
else
  raise "set fname="
end
class String
  def +(other)
    if Integer === other
      if /\A(\w+)?([+-]?\d+)?\Z/ =~ self
        off = $2.to_i + other
        if off == 0
          return $1
        else
          return "#{$1}#{off}"
        end
      end
    end
    return "#{self}#{other}"
  end
  def -(other)
    self+(-other)
  end
  def inspect
    if /\A(\w+)?[+-]?0\Z/ =~ self
      return $1
    else
      self.to_s
    end
  end
end
class Integer
  alias :_inspect :inspect
  def inspect
    0==self ? "" : self>0 ? "+"+_inspect : _inspect
  end
  alias :_to_s :to_s
  def to_s
    0==self ? "" : self>0 ? "+"+_to_s : _to_s
  end
end
# orders of the flux at the kk-th level from the bottom (KS+kk) and from the top (KE-1-kk)
def order_lo(order, nh, kk=0)
  [[order-(nh-kk)*2,[order,2].min].max,[order-(nh-kk-1)*2,[order,2].min].max]
end
def order_up(order, nh, kk=0)
  [[order-(nh-kk-1)*2,[order,2].min].max,[order-(nh-kk)*2,[order,2].min].max]
end
def flux1(idx0)
  "val(#{idx0})"
end
def flux2(idx1,idx0)
  "F2 * ( val(#{idx1})+val(#{idx0}) )"
end
def flux3(idx1,idx0,idxn1)
  "( 2.0_RP * val(#{idx1}) + 5.0_RP * val(#{idx0}) - val(#{idxn1}) ) / 6.0_RP"
end
def flux3k(idx1,idx0,idxn1)
                      "( val(#{idx0}) &
                       + 0.5_RP * phi_dv(val(#{idx1}),val(#{idx0}),val(#{idxn1})) )"
end
def flux4(idx2,idx1,idx0,idxn1)
                      "F41 * ( val(#{idx1})+val(#{idx0}) ) &
                     + F42 * ( val(#{idx2})+val(#{idxn1}) )"
end
def flux5(idx2,idx1,idx0,idxn1,idxn2)
                      "( -  3.0_RP * val(#{idx2})  &
                         + 27.0_RP * val(#{idx1})  &
                         + 47.0_RP * val(#{idx0})  &
                         - 13.0_RP * val(#{idxn1}) &
                         + 2.0_RP * val(#{idxn2}) ) / 60.0_RP"
end
def flux6(idx3,idx2,idx1,idx0,idxn1,idxn2)
                      "F61 * ( val(#{idx1})+val(#{idx0}) ) &
                     + F62 * ( val(#{idx2})+val(#{idxn1}) ) &
                     + F63 * ( val(#{idx3})+val(#{idxn2}) )"
end
def flux7(idx3,idx2,idx1,idx0,idxn1,idxn2,idxn3)
                      "(     4.0_RP * val(#{idx3})   &
                         -  38.0_RP * val(#{idx2})   &
                         + 214.0_RP * val(#{idx1})   &
                         + 319.0_RP * val(#{idx0})   &
                         - 101.0_RP * val(#{idxn1})  &
                         +  25.0_RP * val(#{idxn2})  &
                         - 3.0_RP * val(#{idxn3}) ) / 420.0_RP"
end
def flux8(idx4,idx3,idx2,idx1,idx0,idxn1,idxn2,idxn3)
                      "F81 * ( val(#{idx1})+val(#{idx0}) ) &
                     + F82 * ( val(#{idx2})+val(#{idxn1}) ) &
                     + F83 * ( val(#{idx3})+val(#{idxn2}) ) &
                     + F84 * ( val(#{idx4})+val(#{idxn3}) )"
end

def flux(vel, order, dir, k="k", i="i", j="j", dim=3)
  if dim==3
    idx = [k,i,j]
  elsif dim==1
    idx = [k]
  end
  idx0 = idx.join(",")
  idx1 = idx.dup
  idx1[dir] = idx1[dir]+1
  idx1 = idx1.join(",")
  idxn1 = idx.dup
  idxn1[dir] = idxn1[dir]-1
  idxn1 = idxn1.join(",")
  idx2 = idx.dup
  idx2[dir] = idx2[dir]+2
  idx2 = idx2.join(",")
  idxn2 = idx.dup
  idxn2[dir] = idxn2[dir]-2
  idxn2 = idxn2.join(",")
  idx3 = idx.dup
  idx3[dir] = idx3[dir]+3
  idx3 = idx3.join(",")
  idxn3 = idx.dup
  idxn3[dir] = idxn3[dir]-3
  idxn3 = idxn3.join(",")
  idx4 = idx.dup
  idx4[dir] = idx4[dir]+4
  idx4 = idx4.join(",")
  if Array===order && order.max % 2 == 0
    order = order.min
  end
  case order
  when Array
    ou = order[0]
    od = order[1]
    case ou
    when 1, -1
      fu = flux1(idx0)
    when 2
      if @scheme=="ud3Koren1993"
#        fu = flux1(idx0)
        fu = flux2(idx1,idx0)
      else
        fu = flux2(idx1,idx0)
      end
    when 3
      if @scheme=="ud3Koren1993"
        fu = flux3k(idx1,idx0,idxn1)
      else
        fu = flux3(idx1,idx0,idxn1)
      end
    when 4
       fu = flux4(idx2,idx1,idx0,idxn1)
    when 5
       fu = flux5(idx2,idx1,idx0,idxn1,idxn2)
    when 6
       fu = flux6(idx3,idx2,idx1,idx0,idxn1,idxn2)
    when 7
       fu = flux7(idx3,idx2,idx1,idx0,idxn1,idxn2,idxn3)
    else
       raise "invalid order: #{order}"
    end
    case od
    when 1, -1
      fd = flux1(idx1)
    when 2
      if @scheme=="ud3Koren1993"
#        fd = flux1(idx1)
        fd = flux2(idx1,idx0)
      else
        fd = flux2(idx1,idx0)
      end
    when 3
      if @scheme=="ud3Koren1993"
        fd = flux3k(idx0,idx1,idx2)
      else
        fd = flux3(idx0,idx1,idx2)
      end
    when 4
       fd = flux4(idx2,idx1,idx0,idxn1)
    when 5
       fd = flux5(idxn1,idx0,idx1,idx2,idx3)
    when 6
       fd = flux6(idx3,idx1,idx0,idxn1,idxn2,idxn3)
    when 7
       fd = flux7(idxn2,idxn1,idx0,idx1,idx2,idx3,idx4)
    else
       raise "invalid order: #{order}"
    end
    # vel = -0.0 takes the upwind (fu) side, unlike the weights 0.5 +- sign(0.5,vel).
    # This changes only valueW_Z at exactly zero velocity (the fluxes are multiplied by vel).
    # Testing the sign bit with sign() would cost extra instructions in the kernels.
                 "merge( #{fu}, &
                       #{fd}, &
                       #{vel} >= 0.0_RP )"
  when 1
    "F1 * ( val(#{idx1})+val(#{idx0}) ) - sign(F1,#{vel}) * ( val(#{idx1})-val(#{idx0}) )"
  when 2
    "#{flux2(idx1,idx0)}"
  when 3
    if @scheme=="ud3Koren1993"
                      "flux3k_upwind( #{vel}, val(#{idxn1}), val(#{idx0}), val(#{idx1}), val(#{idx2}) )"
    else
                      "( F31 * ( val(#{idx2})+val(#{idxn1}) ) + F32 * ( val(#{idx1})+val(#{idx0}) ) ) &
                     - ( F31 * ( val(#{idx2})-val(#{idxn1}) ) + F33 * ( val(#{idx1})-val(#{idx0}) ) ) * sign(1.0_RP,#{vel})"
    end
  when 4
                      "#{flux4(idx2,idx1,idx0,idxn1)}"
  when 5
                      "( F51 * ( val(#{idx3})+val(#{idxn2}) ) &
                       + F52 * ( val(#{idx2})+val(#{idxn1}) ) &
                       + F53 * ( val(#{idx1})+val(#{idx0}) ) ) &
                     - ( F51 * ( val(#{idx3})-val(#{idxn2}) ) &
                       + F54 * ( val(#{idx2})-val(#{idxn1}) ) &
                       + F55 * ( val(#{idx1})-val(#{idx0}) ) ) * sign(1.0_RP,#{vel})"
  when 6
                      "#{flux6(idx3,idx2,idx1,idx0,idxn1,idxn2)}"
  when 7
                      "( F71 * ( val(#{idx4})+val(#{idxn3}) ) &
                       + F72 * ( val(#{idx3})+val(#{idxn2}) ) &
                       + F73 * ( val(#{idx2})+val(#{idxn1}) ) &
                       + F74 * ( val(#{idx1})+val(#{idx0}) ) ) &
                     - ( F71 * ( val(#{idx4})-val(#{idxn3}) ) &
                       + F75 * ( val(#{idx3})-val(#{idxn2}) ) &
                       + F76 * ( val(#{idx2})-val(#{idxn1}) ) &
                       + F77 * ( val(#{idx1})-val(#{idx0}) ) ) * sign(1.0_RP,#{vel})"
  when 8
                      "#{flux8(idx4,idx3,idx2,idx1,idx0,idxn1,idxn2,idxn3)}"
  else
    raise "invalid order: #{order}"
  end
end

def interp(val, src, dst, k="k", i="i", j="j", scalars=nil)
  ret = nil
  case
  when src == dst
    ret = "#{val}(#{k},#{i},#{j})"
  when src[2] == dst[2] # z==z
    ret = interpH(val, src[0..1], dst[0..1], k, i, j)
  when src[2..2] == "Z" # Z->W
    raise "scalars Hash is required for Z->W interpolation" if scalars.nil?
    v0 = interpH(val, src[0..1], dst[0..1], k  , i, j)
    v1 = interpH(val, src[0..1], dst[0..1], k+1, i, j)
    sname1, sname2 = register_f2h(scalars, dst, k)
    # No line break is needed between sname and v. Keep a line break between v1 and v0.
    ret = "#{sname1} * #{v1} &
             + #{sname2} * #{v0}"
  else # W=>Z
    v0 = interpH(val, src[0..1], dst[0..1], k-1, i, j)
    v1 = interpH(val, src[0..1], dst[0..1], k  , i, j)
    ret = "0.5_RP * ( #{v0} &
                        + #{v1} )"
  end
  return ret ? "( #{ret} )" : raise("BUG")
end

def f2h_snames(dst, k)
  tag = "#{dst[0..1]}Z_#{k}".gsub("+", "p").gsub("-", "m").gsub(/[^a-zA-Z0-9_]/, "_")
  ["f2h1_#{tag}", "f2h2_#{tag}"]
end

def register_f2h(scalars, dst, k)
  h1, h2 = f2h_snames(dst, k)
  unless scalars.key?(h1)
    scalars[h1] = { h1: h1, h2: h2, expr: "F2H(#{k},I_#{dst[0..1]}Z)" }
  end
  [h1, h2]
end

def f2h_decls(scalars)
  return "" if scalars.nil? || scalars.empty?
  scalars.each_value.map { |info|
    "    real(RP) :: #{info[:h1]}, #{info[:h2]}"
  }.join("\n")
end

def f2h_privates(scalars, chunk=4)
  return "" if scalars.nil? || scalars.empty?
  names = []
  scalars.each_value do |info|
    names << info[:h1] << info[:h2]
  end
  names.each_slice(chunk).map { |ns|
    "    !$omp private(#{ns.join(",")}) &"
  }.join("\n")
end

# Assign only F2H scalars that appear in the given expression strings.
def f2h_assigns(scalars, *exprs)
  return "" if scalars.nil? || scalars.empty? || exprs.empty?
  indent = "       "
  text = exprs.join(" ")
  lines = []
  scalars.each_value do |info|
    h1 = info[:h1]
    # Word-boundary match: avoid f2h1_UYZ_KS matching inside f2h1_UYZ_KSp1
    next unless text.match?(/\b#{Regexp.escape(h1)}\b/)
    h2 = info[:h2]
    lines << "#{indent}#{h1} = #{info[:expr]}"
    lines << "#{indent}#{h2} = 1.0_RP - #{h1}"
  end
  return "" if lines.empty?
  lines.join("\n")
end

def interpH(val, src, dst, k="k", i="i", j="j")
  case
  when src == dst
    return "#{val}(#{k},#{i},#{j})"
  when src[0] == dst[0] # x==x, y!=y
    if src[1..1]=="Y" # Y->V
      jo = 1
    else # V->Y
      jo = -1
    end
    return "0.5_RP * ( #{val}(#{k},#{i},#{j})+#{val}(#{k},#{i},#{j+jo}) )"
  when src[1] == dst[1] # x!=x, y==y
    if src[0..0]=="X" # X->U
      io = 1
    else # U->X
      io = -1
    end
    return "0.5_RP * ( #{val}(#{k},#{i},#{j})+#{val}(#{k},#{i+io},#{j}) )"
  else # x!=x, y!=y
    if src[0..0]=="X" # X->U
      io = 1
    else # U->X
      io = -1
    end
    if src[1..1]=="Y" # Y->V
      jo = 1
    else # V->Y
      jo = -1
    end
    "0.25_RP * ( #{val}(#{k},#{i},#{j})+#{val}(#{k},#{i+io},#{j})+#{val}(#{k},#{i},#{j+jo})+#{val}(#{k},#{i+io},#{j+jo}) )"
  end
end
# The boundary candidates are evaluated at every level in the fused kernel. A division
# in them is an IEEE division for all the threads, which increases the instructions
# and registers so much that the fused kernel is slower than the two kernels
# (UD3 fluxZ_XYZ: 418 -> 598 ms per 2400 calls on GB200).
# In the fused kernel, the division by 6 is therefore replaced by the multiplication
# by F6 = 1/6, which changes the boundary fluxes in the last bit, and the fusion is
# done only if no division remains in the boundary candidates.
# For ud3Koren1993, the fusion is not done either. With phi() with the division,
# even evaluated once per candidate (flux3k_upwind), the fused fluxZ_XYZ was slower
# (841 -> 1143 ms per 2700 calls). With phi_dv() without the division, it is still
# slower (498 -> 567 ms per 2700 calls).
def flux_bnd(*args)
  flux(*args).gsub("/ 6.0_RP", "* F6")
end
fuse_lu = fuse && ( flux_bnd("v", order_lo(order, nh), 0) + flux_bnd("v", order_up(order, nh), 0) ) !~ %r{/|phi_dv\(|flux3k_upwind\(}
use_f6  = fuse_lu && ( flux_bnd("v", order_lo(order, nh), 0) + flux_bnd("v", order_up(order, nh), 0) ).include?("F6")
