  # the metric is used only for the F2H weights here, so take the precomputed weights instead
  scalars_j.each_value { |info| info[:expr] = info[:expr].sub(/F2H\(([^,]+),[^)]*\)/) { "F2HW(#{$1},i,j)" } }
%>
  !-----------------------------------------------------------------------------
  !> calculation <%=dir%>-flux at <%=uv%>Z
  subroutine ATMOS_DYN_FVM_flux<%=dir%>_<%=uv%>Z_<%=@scheme%>( &
       flux,              &
       mom, val, DENS,    &
       F2HW, <%=dir%>G, RMAPF, &
       CDZ, TwoD,         &
       IIS, IIE, JJS, JJE )
    implicit none

    real(RP), intent(inout) :: flux    (KA,IA,JA)
    real(RP), intent(in)  :: mom     (KA,IA,JA)
    real(RP), intent(in)  :: val     (KA,IA,JA)
    real(RP), intent(in)  :: DENS    (KA,IA,JA)
    real(RP), intent(in)  :: F2HW    (KA,IA,JA) !< F2H weight of the full level k+1
    real(RP), intent(in)  :: <%=dir%>G    (KA,IA,JA)
    real(RP), intent(in)  :: RMAPF   (   IA,JA,2) !< 1 / map factor
    real(RP), intent(in)  :: CDZ     (KA)
    logical,  intent(in)  :: TwoD
    integer,  intent(in)  :: IIS, IIE, JJS, JJE

    real(RP) :: vel
<%- if fuse_lu -%>
#ifdef _OPENACC
    real(RP) :: flo, fup, fin
#endif
<%- end -%>
<%= f2h_decls(scalars_j) %>
    integer  :: k, i, j
    !---------------------------------------------------------------------------

    !$omp parallel default(none) private(i,j,k,vel) &
<%= f2h_privates(scalars_j) %>
    !$omp shared(JJS,JJE,IIS,IIE,KS,KE,mom,val,DENS,flux,<%=dir%>G,RMAPF) &
    !$omp shared(F2HW,CDZ,TwoD)

    !$acc data copy(flux) copyin(mom, val, DENS, F2HW, <%=dir%>G, RMAPF, CDZ)

<% if i==1 && im==1 %>
    if ( TwoD ) then

    !$omp do OMP_SCHEDULE_
    !$acc kernels
    do j = JJS, JJE
    do k = KS<%=nh%>, KE<%=-nh-1%>
       i = IIS
<%= f2h_assigns(scalars_j, mom_xyw_k, dens_xyw_k) %>
       vel = <%= mom_xyw_k %> &
           / <%= dens_xyw_k %>
       vel = vel * <%=dir%>G(k,i,j)
       flux(k,i,j) = vel * ( <%= flux("vel", order, 0) %> )
    enddo
    enddo
    !$acc end kernels
    !$omp end do nowait

    !$omp do OMP_SCHEDULE_
    !$acc kernels
    do j = JJS, JJE
       i = IIS
       ! The boundary condition is qflx_hi + qflxJ13 + qfluxJ23 = 0 at KS-1.
       ! The flux at KS-1 can be non-zero.
       ! To reduce calculations, all the fluxes are set to zero.
       flux(KS-1,i,j) = 0.0_RP
<% bnd_xyw.each do |kk, mks, dks, mke, dke| %>
<%= f2h_assigns(scalars_j, mks, dks) %>
       vel = <%= mks %> &
           / <%= dks %>
       vel = vel * <%=dir%>G(KS<%=kk%>,i,j)
       flux(KS<%=kk%>,i,j) = vel * RMAPF(i,j,<%=im%>) &
                   * ( <%= flux("vel", [[order-(nh-kk)*2,[order,2].min].max,[order-(nh-kk-1)*2,[order,2].min].max], 0, "KS"+kk) %> )

<%= f2h_assigns(scalars_j, mke, dke) %>
       vel = <%= mke %> &
           / <%= dke %>
       vel = vel * <%=dir%>G(KE<%=-kk-1%>,i,j)
       flux(KE<%=-kk-1%>,i,j) = vel * RMAPF(i,j,<%=im%>) &
                   * ( <%= flux("vel", [[order-(nh-kk-1)*2,[order,2].min].max,[order-(nh-kk)*2,[order,2].min].max], 0, "KE"-(kk+1)) %> )
<% end %>
       flux(KE  ,i,j) = 0.0_RP
    enddo
    !$acc end kernels
    !$omp end do nowait

    else
<% end %>

<%- if fuse_lu -%>
#ifdef _OPENACC
    ! The fluxes at the boundary levels are selected with merge() in the kernel for
    ! the inner levels (see fluxZ_XYZ).
    ! The values in the halo are read but not used.
    !$acc parallel loop collapse(3)
    do j = JJS, JJE
    do i = IIS, IIE
    do k = KS-1, KE
<%= f2h_assigns(scalars_j, mom_uvw_k, dens_uvw_k) %>
       vel = <%= mom_uvw_k %> &
           / <%= dens_uvw_k %>
       vel = vel * <%=dir%>G(k,i,j)
       flo = <%= flux_bnd("vel", order_lo(order, nh), 0) %>
       fup = <%= flux_bnd("vel", order_up(order, nh), 0) %>
       fin = <%= flux("vel", order, 0) %>
       ! The boundary condition is qflx_hi + qflxJ13 + qfluxJ23 = 0 at KS-1.
       ! The flux at KS-1 can be non-zero.
       ! To reduce calculations, all the fluxes are set to zero.
       flux(k,i,j) = merge( vel * RMAPF(i,j,<%=im%>) &
                   * ( merge( fup, merge( flo, fin, k == KS ), k == KE-1 ) ), &
                            0.0_RP, KS <= k .and. k <= KE-1 )
    enddo
    enddo
    enddo
#else
<%- end -%>
    !$omp do OMP_SCHEDULE_ collapse(2)
    !$acc parallel loop collapse(3)
    do j = JJS, JJE
    do i = IIS, IIE
    do k = KS<%=nh%>, KE<%=-nh-1%>
<%= f2h_assigns(scalars_j, mom_uvw_k, dens_uvw_k) %>
       vel = <%= mom_uvw_k %> &
           / <%= dens_uvw_k %>
       vel = vel * <%=dir%>G(k,i,j)
       flux(k,i,j) = vel * RMAPF(i,j,<%=im%>) &
                   * ( <%= flux("vel", order, 0) %> )
    enddo
    enddo
    enddo
    !$omp end do nowait

    !$omp do OMP_SCHEDULE_ collapse(2)
    !$acc kernels
    do j = JJS, JJE
    do i = IIS, IIE
       ! The boundary condition is qflx_hi + qflxJ13 + qfluxJ23 = 0 at KS-1.
       ! The flux at KS-1 can be non-zero.
       ! To reduce calculations, all the fluxes are set to zero.
       flux(KS-1,i,j) = 0.0_RP
<% bnd_uvw.each do |kk, mks, dks, mke, dke| %>
<%= f2h_assigns(scalars_j, mks, dks) %>
       vel = <%= mks %> &
           / <%= dks %>
       vel = vel * <%=dir%>G(KS<%=kk%>,i,j)
       flux(KS<%=kk%>,i,j) = vel * RMAPF(i,j,<%=im%>) &
                   * ( <%= flux("vel", [[order-(nh-kk)*2,[order,2].min].max,[order-(nh-kk-1)*2,[order,2].min].max], 0, "KS"+kk) %> )

<%= f2h_assigns(scalars_j, mke, dke) %>
       vel = <%= mke %> &
           / <%= dke %>
       vel = vel * <%=dir%>G(KE<%=-kk-1%>,i,j)
       flux(KE<%=-kk-1%>,i,j) = vel * RMAPF(i,j,<%=im%>) &
                   * ( <%= flux("vel", [[order-(nh-kk-1)*2,[order,2].min].max,[order-(nh-kk)*2,[order,2].min].max], 0, "KE"-(kk+1)) %> )
<% end %>
       flux(KE  ,i,j) = 0.0_RP
    enddo
    enddo
    !$acc end kernels
    !$omp end do nowait
<%- if fuse_lu -%>
#endif
<%- end -%>

<% if i==1 && im==1 %>
    end if
<% end %>

    !$acc end data

    !$omp end parallel
    return
  end subroutine ATMOS_DYN_FVM_flux<%=dir%>_<%=uv%>Z_<%=@scheme%>
<% end # J13 J23 loop %>
<% [
     ["X", 1, 0],
     ["Y", 0, 1]
   ].each do |dir, ii, jj|
%>
  !-----------------------------------------------------------------------------
  !> calculation <%=dir%>-flux at <%=uv%>
  subroutine ATMOS_DYN_FVM_flux<%=dir%>_<%=uv%>Z_<%=@scheme%>( &
       flux,              &
       mom, val, DENS,    &
       GSQRT, RMAPF,      &
       num_diff,          &
       CDZ, TwoD,         &
       IIS, IIE, JJS, JJE )
    implicit none

    real(RP), intent(inout) :: flux    (KA,IA,JA)
    real(RP), intent(in)  :: mom     (KA,IA,JA)
    real(RP), intent(in)  :: val     (KA,IA,JA)
    real(RP), intent(in)  :: DENS    (KA,IA,JA)
    real(RP), intent(in)  :: GSQRT   (KA,IA,JA)
    real(RP), intent(in)  :: RMAPF   (   IA,JA,2) !< 1 / map factor
    real(RP), intent(in)  :: num_diff(KA,IA,JA)
    real(RP), intent(in)  :: CDZ     (KA)
    logical,  intent(in)  :: TwoD
    integer,  intent(in)  :: IIS, IIE, JJS, JJE

    real(RP) :: vel
    integer  :: k, i, j
    !---------------------------------------------------------------------------
<% if uv=="UY" && dir=="X" %>
    ! note that x-index is added by -1
<%
     io = 1
   else
     io = 0
   end
   if uv=="XV" && dir=="Y"
%>
    ! note that y-index is added by -1
<%
     jo = 1
   else
     jo = 0
   end

   dst = uv
   if dir=="X"
     dst = dst[0..0]=="X" ? "U"+dst[1..1] : "X"+dst[1..1]
   else # dir=="Y"
     dst = dst[1..1]=="Y" ? dst[0..0]+"V" : dst[0..0]+"Y"
   end
%>

<% if i==1 && jj==1 %>
    if ( TwoD ) then

    !$omp parallel do default(none) private(i,j,k) OMP_SCHEDULE_ &
    !$omp private(vel) &
    !$omp shared(JJS,JJE,IIS,IIE,KS,KE,mom,val,DENS,flux,GSQRT,RMAPF,num_diff,TwoD)
    !$acc kernels
    do j = JJS<%=-jj+jo%>, JJE<%=jo%>
    do k = KS, KE
       i = IIS
#ifdef DEBUG
       call CHECK( __LINE__, mom(k,i  ,j) )
<% (nh+1).times do |n| %>
       call CHECK( __LINE__, val(k,i<%=-n*ii-io%>,j<%=-n*jj-jo%>) )
       call CHECK( __LINE__, val(k,i<%=(n+1)*ii-io%>,j<%=(n+1)*jj-jo%>) )
<% end %>
#endif
       vel = <%= interp("mom", dir=="X" ? "UYZ" : "XVZ", "XVZ") %> &
           / <%= interp("DENS", "XYZ", "XVZ") %>
       flux(k,i<%=-io%>,j<%=-jo%>) = GSQRT(k,i,j) * RMAPF(i,j,<%=ii*2+jj%>) * vel &
                   * ( <%= flux("vel", order, ii+jj*2, "k", "i"-io, "j"-jo) %> ) <%= num_diff() %>
    enddo
    enddo
    !$acc end kernels
#ifdef DEBUG
    k = IUNDEF; i = IUNDEF; j = IUNDEF
#endif

    else

<% end %>
    !$omp parallel do default(none) private(i,j,k) OMP_SCHEDULE_ collapse(2) &
    !$omp private(vel) &
    !$omp shared(JJS,JJE,IIS,IIE,KS,KE,mom,val,DENS,flux,GSQRT,RMAPF,num_diff)
    !$acc parallel loop collapse(3)
    do j = JJS<%=-jj+jo%>, JJE<%=jo%>
    do i = IIS<%=-ii+io%>, IIE<%=io%>
    do k = KS, KE
#ifdef DEBUG
       call CHECK( __LINE__, mom(k,i  ,j) )
       call CHECK( __LINE__, mom(k,i<%=-i%>,j<%=-j%>) )
<% (nh+1).times do |n| %>
       call CHECK( __LINE__, val(k,i<%=-n*ii-io%>,j<%=-n*jj-jo%>) )
       call CHECK( __LINE__, val(k,i<%=(n+1)*ii-io%>,j<%=(n+1)*jj-jo%>) )
<% end %>
#endif
       vel = <%= interp("mom", dir=="X" ? "UYZ" : "XVZ", dst+"Z") %> &
           / <%= interp("DENS", "XYZ", dst+"Z") %>
       flux(k,i<%=-io%>,j<%=-jo%>) = GSQRT(k,i,j) * RMAPF(i,j,<%=ii*2+jj%>) * vel &
                   * ( <%= flux("vel", order, ii+jj*2, "k", "i"-io, "j"-jo) %> ) <%= num_diff() %>
    enddo
    enddo
    enddo
#ifdef DEBUG
    k = IUNDEF; i = IUNDEF; j = IUNDEF
#endif

<% if i==1 && jj==1 %>
    end if
<% end %>

    return
  end subroutine ATMOS_DYN_FVM_flux<%=dir%>_<%=uv%>Z_<%=@scheme%>
<% end %>
<%# -- X Y loop ------- %>
<% end %>
<%# -- U V loop ------- %>

<% if @scheme == "ud3Koren1993" %>
  !-----------------------------------------------------------------------------
  !> phi(r) * (v2-v3) of Koren (1993), where r = 2 (v1-v2) / (v2-v3)
  !> phi(r) = max(0, min(r, (1+r)/3, 2)) is multiplied by v2-v3 before it is evaluated,
  !> so that no division is needed. With a division, which calls the slow path of
  !> the IEEE division, the kernels use more registers and are slower
  !> (fluxX_XYZ: 50 -> 40 registers, 628 -> 397 ms per 2700 calls on GB200).
  function phi_dv(v1, v2, v3)
    !$acc routine seq
    implicit none

    real(RP)              :: phi_dv
#ifdef _OPENACC
    real(RP), intent(in), value :: v1
    real(RP), intent(in), value :: v2
    real(RP), intent(in), value :: v3
#else
    real(RP), intent(in) :: v1
    real(RP), intent(in) :: v2
    real(RP), intent(in) :: v3
#endif

    real(RP) :: sw, a, b
    !---------------------------------------------------------------------------

    ! a and b are 2 (v1-v2) and v2-v3 multiplied by the sign of v2-v3, so that b >= 0
    sw = sign( 1.0_RP, v2-v3 )
    a  = sw * 2.0_RP * ( v1-v2 )
    b  = sw * ( v2-v3 )

    phi_dv = sw * max( 0.0_RP, min( a, ( a + b ) * ( 1.0_RP / 3.0_RP ), 2.0_RP * b ) )

  end function phi_dv

  !-----------------------------------------------------------------------------
  !> Koren (1993) flux at the face between v0 and v1, upwinded by the sign of vel
  !> The stencil is selected before phi_dv() is evaluated, so phi_dv() is evaluated once.
  function flux3k_upwind(vel, vn1, v0, v1, v2)
    !$acc routine seq
    implicit none

    real(RP)              :: flux3k_upwind
#ifdef _OPENACC
    real(RP), intent(in), value :: vel
    real(RP), intent(in), value :: vn1
    real(RP), intent(in), value :: v0
    real(RP), intent(in), value :: v1
    real(RP), intent(in), value :: v2
#else
    real(RP), intent(in) :: vel
    real(RP), intent(in) :: vn1
    real(RP), intent(in) :: v0
    real(RP), intent(in) :: v1
    real(RP), intent(in) :: v2
#endif

    real(RP) :: vu, vc, vd
    logical  :: up
    !---------------------------------------------------------------------------

    up = vel >= 0.0_RP
    vu = merge( vn1, v2, up ) ! upwind of vc
    vc = merge( v0,  v1, up ) ! upwind cell
    vd = merge( v1,  v0, up ) ! downwind cell

    flux3k_upwind = vc + 0.5_RP * phi_dv(vd, vc, vu)

  end function flux3k_upwind
<% end %>

end module <%= modname %>

