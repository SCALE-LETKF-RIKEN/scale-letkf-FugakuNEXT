  !-----------------------------------------------------------------------------
  !> value at XYW
!OCL SERIAL
  subroutine ATMOS_DYN_FVM_flux_valueW_Z_<%=@scheme%>( &
       valW,             &
       mflx, val, GSQRT, &
       CDZ               )
    !$acc routine vector
    implicit none

    real(RP), intent(out) :: valW (KA)
    real(RP), intent(in)  :: mflx (KA)
    real(RP), intent(in)  :: val  (KA)
    real(RP), intent(in)  :: GSQRT(KA)
    real(RP), intent(in)  :: CDZ  (KA)

    integer  :: k
    !---------------------------------------------------------------------------

    do k = KS<%=nh%>, KE<%=-(nh+1)%>
#ifdef DEBUG
       call CHECK( __LINE__, mflx(k) )
<% (nh+1).times do |k| %>
       call CHECK( __LINE__, val(k<%=-k%>) )
       call CHECK( __LINE__, val(k<%=k+1%>) )
<% end %>
#endif
       valW(k)       = <%= flux("mflx(k)", order, 0, "k", nil, nil, 1) %>
    enddo
#ifdef DEBUG
    k = IUNDEF
#endif

#ifdef DEBUG
<% nh.times do |k| %>
       call CHECK( __LINE__, mflx(KS<%=k%>) )
       call CHECK( __LINE__, val(KS<%=k*2%>  ) )
       call CHECK( __LINE__, val(KS<%=k*2+1%>) )
       call CHECK( __LINE__, mflx(KE<%=-k-1%>) )
       call CHECK( __LINE__, val(KE<%=-k*2%>  ) )
       call CHECK( __LINE__, val(KE<%=-k*2-1%>) )
<% end %>
#endif
<% nh.times do |k| %>
       valW(KS<%=k%>) = <%= flux("mflx(KS#{k})", [[order-(nh-k)*2,[order,2].min].max,[order-(nh-k-1)*2,[order,2].min].max], 0, "KS"+k, nil, nil, 1) %>
       valW(KE<%=-k-1%>) = <%= flux("mflx(KE#{-(k+1)})", [[order-(nh-k-1)*2,[order,2].min].max,[order-(nh-k)*2,[order,2].min].max], 0, "KE"-(k+1), nil, nil, 1) %>
<% end %>

    return
  end subroutine ATMOS_DYN_FVM_flux_ValueW_Z_<%=@scheme%>

  !-----------------------------------------------------------------------------
  !> calculation z-flux at XYZ
  subroutine ATMOS_DYN_FVM_fluxZ_XYZ_<%=@scheme%>( &
       flux,              &
       mflx, val, GSQRT,  &
       num_diff,          &
       CDZ,               &
       IIS, IIE, JJS, JJE )
    use scale_const, only: &
      EPS => CONST_EPS
    implicit none

    real(RP), intent(inout) :: flux    (KA,IA,JA)
    real(RP), intent(in)  :: mflx    (KA,IA,JA)
    real(RP), intent(in)  :: val     (KA,IA,JA)
    real(RP), intent(in)  :: GSQRT   (KA,IA,JA)
    real(RP), intent(in)  :: num_diff(KA,IA,JA)
    real(RP), intent(in)  :: CDZ     (KA)
    integer,  intent(in)  :: IIS, IIE, JJS, JJE

    real(RP) :: vel
    integer  :: k, i, j
    !---------------------------------------------------------------------------

    !$omp parallel default(none) private(i,j,k, vel)                    &
    !$omp shared(JJS,JJE,IIS,IIE,KS,KE,mflx,val,flux,GSQRT,num_diff,EPS)

    !$acc data copy(flux) copyin(mflx, val, GSQRT, num_diff, CDZ)

    !$omp do OMP_SCHEDULE_ collapse(2)
    !$acc kernels
    do j = JJS, JJE
    do i = IIS, IIE
    do k = KS<%=nh%>, KE<%=-(nh+1)%>
#ifdef DEBUG
       call CHECK( __LINE__, mflx(k,i,j) )
<% (nh+1).times do |k| %>
       call CHECK( __LINE__, val(k<%=-k%>,i,j) )
       call CHECK( __LINE__, val(k<%=k+1%>,i,j) )
<% end %>
#endif
       vel = mflx(k,i,j)
       flux(k,i,j) = vel &
                   * ( <%= flux("vel", order,0) %> ) <%= num_diff() %>
    enddo
    enddo
    enddo
    !$acc end kernels
    !$omp end do nowait
#ifdef DEBUG
    k = IUNDEF; i = IUNDEF; j = IUNDEF
#endif

    !$omp do OMP_SCHEDULE_ collapse(2)
    !$acc kernels
    do j = JJS, JJE
    do i = IIS, IIE
#ifdef DEBUG
<% nh.times do |k| %>
       call CHECK( __LINE__, mflx(KS<%=k%>,i,j) )
       call CHECK( __LINE__, val(KS<%=k*2%>  ,i,j) )
       call CHECK( __LINE__, val(KS<%=k*2+1%>,i,j) )
       call CHECK( __LINE__, mflx(KE<%=-k-1%>,i,j) )
       call CHECK( __LINE__, val(KE<%=-k*2%>  ,i,j) )
       call CHECK( __LINE__, val(KE<%=-k*2-1%>,i,j) )
<% end %>
#endif
       flux(KS-1,i,j) = 0.0_RP
<% nh.times do |k| %>
       vel = mflx(KS<%=k%>,i,j)
       flux(KS<%=k%>,i,j) = vel &
                   * ( <%= flux("vel", [[order-(nh-k)*2,[order,2].min].max,[order-(nh-k-1)*2,[order,2].min].max], 0, "KS"+k) %> ) <%= num_diff("KS"+k) %>
       vel = mflx(KE<%=-(k+1)%>,i,j)
       flux(KE<%=-k-1%>,i,j) = vel &
                   * ( <%= flux("vel", [[order-(nh-k-1)*2,[order,2].min].max,[order-(nh-k)*2,[order,2].min].max], 0, "KE"-(k+1)) %> ) <%= num_diff("KE"-(k+1)) %>
<% end %>
       flux(KE  ,i,j) = 0.0_RP
    enddo
    enddo
    !$acc end kernels
    !$omp end do nowait

    !$acc end data

    !$omp end parallel
#ifdef DEBUG
    k = IUNDEF; i = IUNDEF; j = IUNDEF
#endif

    return
  end subroutine ATMOS_DYN_FVM_fluxZ_XYZ_<%=@scheme%>
<% [
     ["X", 1, 0],
     ["Y", 0, 1]
   ].each do |dir,i,j|
%>
  !-----------------------------------------------------------------------------
  !> calculation <%=dir%>-flux at XYZ
  subroutine ATMOS_DYN_FVM_flux<%=dir%>_XYZ_<%=@scheme%>( &
       flux,              &
       mflx, val, GSQRT,  &
       num_diff,          &
       CDZ,               &
       IIS, IIE, JJS, JJE )
    implicit none

    real(RP), intent(inout) :: flux    (KA,IA,JA)
    real(RP), intent(in)  :: mflx    (KA,IA,JA)
    real(RP), intent(in)  :: val     (KA,IA,JA)
    real(RP), intent(in)  :: GSQRT   (KA,IA,JA)
    real(RP), intent(in)  :: num_diff(KA,IA,JA)
    real(RP), intent(in)  :: CDZ(KA)
    integer,  intent(in)  :: IIS, IIE, JJS, JJE

    real(RP) :: vel
    integer  :: k, i, j
    !---------------------------------------------------------------------------

    !$omp parallel do default(none) private(i,j,k) OMP_SCHEDULE_ collapse(2) &
    !$omp private(vel) &
    !$omp shared(JJS,JJE,IIS,IIE,KS,KE,mflx,val,flux,GSQRT,num_diff)
    !$acc kernels
    do j = JJS<%=-j%>, JJE
    do i = IIS<%=-i%>, IIE
    do k = KS, KE
#ifdef DEBUG
       call CHECK( __LINE__, mflx(k,i,j) )
<% (nh+1).times do |n| %>
       call CHECK( __LINE__, val(k,i<%=-n*i%>,j<%=-n*j%>) )
       call CHECK( __LINE__, val(k,i<%=(n+1)*i%>,j<%=(n+1)*j%>) )
<% end %>
#endif
       vel = mflx(k,i,j)
       flux(k,i,j) = vel &
                   * ( <%=flux("vel", order, i+j*2)%> ) <%= num_diff() %>
    enddo
    enddo
    enddo
    !$acc end kernels
#ifdef DEBUG
    k = IUNDEF; i = IUNDEF; j = IUNDEF
#endif

    return
  end subroutine ATMOS_DYN_FVM_flux<%=dir%>_XYZ_<%=@scheme%>
<% end %>
<%# end X Y loop %>
  !-----------------------------------------------------------------------------
  !> calculation z-flux at XYW
  subroutine ATMOS_DYN_FVM_fluxZ_XYW_<%=@scheme%>( &
       flux,              &
       mom, val, DENS,    &
       GSQRT, J33G,       &
       num_diff,          &
       CDZ, FDZ,          &
       dtrk,              &
       IIS, IIE, JJS, JJE )
    implicit none

    real(RP), intent(inout) :: flux    (KA,IA,JA)
    real(RP), intent(in)  :: mom     (KA,IA,JA)
    real(RP), intent(in)  :: val     (KA,IA,JA)
    real(RP), intent(in)  :: DENS    (KA,IA,JA)
    real(RP), intent(in)  :: GSQRT   (KA,IA,JA)
    real(RP), intent(in)  :: J33G
    real(RP), intent(in)  :: num_diff(KA,IA,JA)
    real(RP), intent(in)  :: CDZ     (KA)
    real(RP), intent(in)  :: FDZ     (KA-1)
    real(RP), intent(in)  :: dtrk
    integer,  intent(in)  :: IIS, IIE, JJS, JJE

    real(RP) :: vel
    integer  :: k, i, j
    !---------------------------------------------------------------------------

    ! note than z-index is added by -1

    !$omp parallel default(none) private(i,j,k,vel)  &
    !$omp shared(JJS,JJE,IIS,IIE,KS,KE,mom,val,flux,J33G,GSQRT,num_diff,DENS,FDZ,dtrk)

    !$acc data copy(flux) copyin(mom, val, DENS, GSQRT, num_diff, CDZ, FDZ)

    !$omp do OMP_SCHEDULE_ collapse(2)
    !$acc kernels
    do j = JJS, JJE
    do i = IIS, IIE
    do k = KS<%=nh+1%>, KE<%=-[nh,1].max%>
#ifdef DEBUG
       call CHECK( __LINE__, mom(k-1,i,j) )
       call CHECK( __LINE__, mom(k  ,i,j) )
<% (nh+1).times do |k| %>
       call CHECK( __LINE__, val(k<%=-k-1%>,i,j) )
       call CHECK( __LINE__, val(k<%=k%>,i,j) )
<% end %>
#endif
       vel = <%= interp("mom", "XYW", "XYZ") %> &
           / DENS(k,i,j)
       flux(k-1,i,j) = J33G * vel &
                   * ( <%= flux("vel", order, 0, "k-1") %> ) <%= num_diff() %>
    enddo
    enddo
    enddo
    !$acc end kernels
    !$omp end do nowait
#ifdef DEBUG
    k = IUNDEF; i = IUNDEF; j = IUNDEF
#endif

    !$omp do OMP_SCHEDULE_ collapse(2)
    !$acc kernels
    do j = JJS, JJE
    do i = IIS, IIE
#ifdef DEBUG
<% if nh >= 1 %>
<%- 0.upto(2*nh-1+order%2) do |k| -%>
       call CHECK( __LINE__, val(KS<%=k%>,i,j) )
<%- end -%>
<% end %>
<% if nh >= 2 %>
<%- (2*nh-1+order%2).downto(1) do |k| -%>
       call CHECK( __LINE__, val(KE<%=-k%>,i,j) )
<%- end -%>
<% end %>
#endif
       ! The boundary condition is qflx_hi + qflxJ13 + qfluxJ23 = 0 at KS.
       ! The flux at KS can be non-zero.
       ! To reduce calculations, all the fluxes are set to zero.
       flux(KS-1,i,j) = 0.0_RP ! k = KS
<% nh.times do |k| %>
       vel = <%= interp("mom", "XYW", "XYZ", "KS"+(k+1)) %> &
           / DENS(KS<%=k+1%>,i,j)
       flux(KS<%=k%>,i,j) = J33G * vel &
                   * ( <%= flux("vel", [[order-(nh-k)*2,[order,2].min].max,[order-(nh-k-1)*2,[order,2].min].max], 0, "KS"+k) %> ) <%= num_diff("KS"+(k+1)) %> ! k = KS<%=k+1%>
<% end %>

<% (nh-2).downto(0) do |k| %>
       vel = <%= interp("mom", "XYW", "XYZ", "KE"-(k+1)) %> &
           / DENS(KE-1,i,j)
       flux(KE<%=-(k+2)%>,i,j) = J33G * vel &
                   * ( <%= flux("vel", [[order-(nh-(k+2))*2,[order,2].min].max,[order-(nh-(k+1))*2,[order,2].min].max], 0, "KE"-(k+2)) %> ) <%= num_diff("KE"-(k+1)) %> ! k = KE<%=-(k+1)%>
<% end %>
       flux(KE-1,i,j) = 0.0_RP ! k = KE
       flux(KE  ,i,j) = 0.0_RP ! k = KE+1
    enddo
    enddo
    !$acc end kernels
    !$omp end do nowait

    !$acc end data

    !$omp end parallel

    return
  end subroutine ATMOS_DYN_FVM_fluxZ_XYW_<%=@scheme%>

<% [
     ["J13", "UYZ", 1,0],
     ["J23", "XVZ", 0,1]
   ].each do |dir, uv, i, j|
%>
  !-----------------------------------------------------------------------------
  !> calculation <%=dir%>-flux at XYW
  subroutine ATMOS_DYN_FVM_flux<%=dir%>_XYW_<%=@scheme%>( &
       flux,              &
       mom, val, DENS,    &
       GSQRT, <%=dir%>G, MAPF, &
       CDZ, TwoD,         &
       IIS, IIE, JJS, JJE )
    implicit none

    real(RP), intent(inout) :: flux    (KA,IA,JA)
    real(RP), intent(in)  :: mom     (KA,IA,JA)
    real(RP), intent(in)  :: val     (KA,IA,JA)
    real(RP), intent(in)  :: DENS    (KA,IA,JA)
    real(RP), intent(in)  :: GSQRT   (KA,IA,JA)
    real(RP), intent(in)  :: <%=dir%>G    (KA,IA,JA)
    real(RP), intent(in)  :: MAPF    (   IA,JA,2)
    real(RP), intent(in)  :: CDZ     (KA)
    logical,  intent(in)  :: TwoD
    integer,  intent(in)  :: IIS, IIE, JJS, JJE

    real(RP) :: vel
    integer  :: k, i, j
    !---------------------------------------------------------------------------

    !$omp parallel default(none) private(i,j,k,vel) &
    !$omp shared(JJS,JJE,IIS,IIE,KS,KE,mom,val,DENS,flux,<%=dir%>G,MAPF)

    !$acc data copy(flux) copyin(mom, val, DENS, GSQRT, <%=dir%>G, MAPF, CDZ)

    !$omp do OMP_SCHEDULE_ collapse(2)
    !$acc kernels
    do j = JJS, JJE
    do i = IIS, IIE
    do k = KS<%=[nh,2].max%>, KE<%=-[nh,1].max%>
       vel = <%= interp("mom", uv, "XYZ") %> &
           / DENS(k,i,j)
       vel = vel * <%=dir%>G(k,i,j)
       flux(k-1,i,j) = vel / MAPF(i,j,<%=i*2+j%>) &
                   * ( <%= flux("vel", order, 0, "k-1") %> )
    enddo
    enddo
    enddo
    !$acc end kernels
    !$omp end do nowait

    !$omp do OMP_SCHEDULE_ collapse(2)
    !$acc kernels
    do j = JJS, JJE
    do i = IIS, IIE
       ! The boundary condition is qflx_hi + qflxJ13 + qfluxJ23 = 0 at KS.
       ! The flux at KS can be non-zero.
       ! To reduce calculations, all the fluxes are set to zero.
       flux(KS-1,i,j) = 0.0_RP ! k = KS

       ! physically incorrect but for numerical stability
       vel = ( <%= interp("mom", uv, "XYZ", "KS+1") %> / DENS(KS+1,i,j) &
             + <%= interp("mom", uv, "XYZ", "KS"  ) %> / DENS(KS  ,i,j) ) * 0.5_RP
!       vel = <%= interp("mom", uv, "XYZ", "KS+1") %> &
!           / DENS(KS+1,i,j)
       vel = vel * <%=dir%>G(KS+1,i,j)
       flux(KS,i,j) =  vel / MAPF(i,j,<%=i*2+j%>) &
                   * ( <%= flux("vel", [[order-nh*2,[order,2].min].max,[order-(nh-1)*2,[order,2].min].max], 0, "KS") %> ) ! k = KS+1
<%   for k in 1...(nh-1) %>
       vel = <%= interp("mom", uv, "XYZ", "KS"+(k+1)) %> &
           / DENS(KS<%=k+1%>,i,j)
       vel = vel * <%=dir%>G(KS<%k+1%>,i,j)
       flux(KS<%=k%>,i,j) = vel / MAPF(i,j,<%=i*2+j%>) &
                   * ( <%= flux("vel", [[order-(nh-k)*2,[order,2].min].max,[order-(nh-k-1)*2,[order,2].min].max], 0, "KS"+k) %> ) ! k = KS<%=k+1%>
<%   end %>
<%   (nh-1).times do |k| %>
       vel = <%= interp("mom", uv, "XYZ", "KE"-(k+1)) %> &
           / DENS(KE<%=-k-1%>,i,j)
       vel = vel * <%=dir%>G(KE<%=-k-1%>,i,j)
       flux(KE<%=-k-2%>,i,j) = vel / MAPF(i,j,<%=i*2+j%>) &
                   * ( <%= flux("vel", [[order-(nh-k-1)*2,[order,2].min].max,[order-(nh-k)*2,[order,2].min].max], 0, "KE"-(k+2)) %> ) ! k = KE<%=-k-3%>
<%   end %>
       flux(KE-1,i,j) = 0.0_RP
    enddo
    enddo
    !$acc end kernels
    !$omp end do nowait

    !$acc end data

    !$omp end parallel

    return
  end subroutine ATMOS_DYN_FVM_flux<%=dir%>_XYW_<%=@scheme%>
<% end # J13, J23 loop %>

<% [
     ["X", "UY", 1, 0],
     ["Y", "XV", 0, 1]
   ].each do |dir, xyz, i, j|
  scalars_xyw = {}
  mom_xyw = interp("mom", xyz+"Z", xyz+"W", "k", "i", "j", scalars_xyw)
  dens_xyw = interp("DENS", "XYZ", xyz+"W", "k", "i", "j", scalars_xyw)
%>
  !-----------------------------------------------------------------------------
  !> calculation <%=dir%>-flux at XYW
  subroutine ATMOS_DYN_FVM_flux<%=dir%>_XYW_<%=@scheme%>( &
       flux,              &
       mom, val, DENS,    &
       GSQRT, MAPF,       &
       num_diff,          &
       CDZ, TwoD,         &
       IIS, IIE, JJS, JJE )
    implicit none

    real(RP), intent(inout) :: flux    (KA,IA,JA)
    real(RP), intent(in)  :: mom     (KA,IA,JA)
    real(RP), intent(in)  :: val     (KA,IA,JA)
    real(RP), intent(in)  :: DENS    (KA,IA,JA)
    real(RP), intent(in)  :: GSQRT   (KA,IA,JA)
    real(RP), intent(in)  :: MAPF    (   IA,JA,2)
    real(RP), intent(in)  :: num_diff(KA,IA,JA)
    real(RP), intent(in)  :: CDZ     (KA)
    logical,  intent(in)  :: TwoD
    integer,  intent(in)  :: IIS, IIE, JJS, JJE

    real(RP) :: vel
<%= f2h_decls(scalars_xyw) %>
    integer  :: k, i, j
    !---------------------------------------------------------------------------

    !$omp parallel default(none) private(i,j,k,vel) &
<%= f2h_privates(scalars_xyw) %>
    !$omp shared(JJS,JJE,IIS,IIE,KS,KE,mom,val,DENS,flux,GSQRT,MAPF,num_diff) &
    !$omp shared(CDZ)

    !$acc data copy(flux) copyin(mom, val, DENS, GSQRT, MAPF, num_diff, CDZ)

    !$omp do OMP_SCHEDULE_ collapse(2)
    !$acc kernels
    do j = JJS<%=-j%>, JJE
    do i = IIS<%=-i%>, IIE
    do k = KS, KE-1
#ifdef DEBUG
       call CHECK( __LINE__, mom(k  ,i,j) )
       call CHECK( __LINE__, mom(k+1,i,j) )
<% (nh+1).times do |n| %>
       call CHECK( __LINE__, val(k,i<%=-n*i%>,j<%=-n*j%>) )
       call CHECK( __LINE__, val(k,i<%= (n+1)*i%>,j<%= (n+1)*j%>) )
<% end %>
#endif
<%= f2h_assigns(scalars_xyw, mom_xyw, dens_xyw) %>
       vel = <%= mom_xyw %> &
           / <%= dens_xyw %>
       flux(k,i,j) = GSQRT(k,i,j) / MAPF(i,j,<%=i*2+j%>) * vel &
                   * ( <%= flux("vel", order, i+2*j) %> ) <%= num_diff() %>
    enddo
    enddo
    enddo
    !$acc end kernels
    !$omp end do nowait
#ifdef DEBUG
    k = IUNDEF; i = IUNDEF; j = IUNDEF
#endif

    !$omp do OMP_SCHEDULE_ collapse(2)
    !$acc kernels
    do j = JJS<%=-j%>, JJE
    do i = IIS<%=-i%>, IIE
       flux(KE,i,j) = 0.0_RP
    enddo
    enddo
    !$acc end kernels
    !$omp end do nowait

    !$acc end data

    !$omp end parallel
#ifdef DEBUG
    k = IUNDEF; i = IUNDEF; j = IUNDEF
#endif

    return
  end subroutine ATMOS_DYN_FVM_flux<%=dir%>_XYW_<%=@scheme%>
<% end # X Y loop %>

<% [
     ["UY", 1, 0],
     ["XV", 0, 1],
   ].each do |uv, i, j|
  scalars_z = {}
  mom_xyw_k = nil
  dens_xyw_k = nil
  bnd_xyw = []
  if i == 1
    mom_xyw_k = interp("mom", "XYW", "XYW", "k", "i", "j", scalars_z)
    dens_xyw_k = interp("DENS", "XYZ", "XYW", "k", "i", "j", scalars_z)
    nh.times do |kk|
      bnd_xyw << [
        kk,
        interp("mom", "XYW", "XYW", "KS"+kk, "i", "j", scalars_z),
        interp("DENS", "XYZ", "XYW", "KS"+kk, "i", "j", scalars_z),
        interp("mom", "XYW", "XYW", "KE"-(kk+1), "i", "j", scalars_z),
        interp("DENS", "XYZ", "XYW", "KE"-(kk+1), "i", "j", scalars_z)
      ]
    end
  end
  mom_uvw_k = interp("mom", "XYW", uv+"W", "k", "i", "j", scalars_z)
  dens_uvw_k = interp("DENS", "XYZ", uv+"W", "k", "i", "j", scalars_z)
  bnd_uvw = []
  nh.times do |kk|
    bnd_uvw << [
      kk,
      interp("mom", "XYW", uv+"W", "KS"+kk, "i", "j", scalars_z),
      interp("DENS", "XYZ", uv+"W", "KS"+kk, "i", "j", scalars_z),
      interp("mom", "XYW", uv+"W", "KE"-(kk+1), "i", "j", scalars_z),
      interp("DENS", "XYZ", uv+"W", "KE"-(kk+1), "i", "j", scalars_z)
    ]
  end
%>
  !-----------------------------------------------------------------------------
  !> calculation z-flux at <%=uv%>
  subroutine ATMOS_DYN_FVM_fluxZ_<%=uv%>Z_<%=@scheme%>( &
       flux,              &
       mom, val, DENS,    &
       GSQRT, J33G,       &
       num_diff,          &
       CDZ, TwoD,         &
       IIS, IIE, JJS, JJE )
    implicit none

    real(RP), intent(inout) :: flux    (KA,IA,JA)
    real(RP), intent(in)  :: mom     (KA,IA,JA)
    real(RP), intent(in)  :: val     (KA,IA,JA)
    real(RP), intent(in)  :: DENS    (KA,IA,JA)
    real(RP), intent(in)  :: GSQRT   (KA,IA,JA)
    real(RP), intent(in)  :: J33G
    real(RP), intent(in)  :: num_diff(KA,IA,JA)
    real(RP), intent(in)  :: CDZ     (KA)
    logical,  intent(in)  :: TwoD
    integer,  intent(in)  :: IIS, IIE, JJS, JJE

    real(RP) :: vel
<%= f2h_decls(scalars_z) %>
    integer  :: k, i, j
    !---------------------------------------------------------------------------

    !$omp parallel default(none) private(i,j,k,vel) &
<%= f2h_privates(scalars_z) %>
    !$omp shared(JJS,JJE,IIS,IIE,KS,KE,mom,val,DENS,flux,J33G,GSQRT,num_diff) &
    !$omp shared(CDZ,TwoD)

    !$acc data copy(flux) copyin(mom, val, DENS, GSQRT, num_diff, CDZ)

<% if i==1 %>
    if ( TwoD ) then

    !$omp do OMP_SCHEDULE_
    !$acc kernels
    do j = JJS, JJE
    do k = KS<%=nh%>, KE<%=-nh-1%>
       i = IIS
#ifdef DEBUG
       call CHECK( __LINE__, mom(k,i,j) )
<% (nh+1).times do |k| %>
       call CHECK( __LINE__, val(k<%=-k%>,i,j) )
       call CHECK( __LINE__, val(k<%=k+1%>,i,j) )
<% end %>
#endif
<%= f2h_assigns(scalars_z, mom_xyw_k, dens_xyw_k) %>
       vel = <%= mom_xyw_k %> &
           / <%= dens_xyw_k %>
       flux(k,i,j) = J33G * vel &
                   * ( <%= flux("vel", order, 0) %> ) <%= num_diff() %>
    enddo
    enddo
    !$acc end kernels
    !$omp end do nowait
#ifdef DEBUG
    k = IUNDEF; i = IUNDEF; j = IUNDEF
#endif

    !$omp do OMP_SCHEDULE_
    !$acc kernels
    do j = JJS, JJE
       i = IIS
#ifdef DEBUG
<% nh.times do |k| %>
       call CHECK( __LINE__, mom(KS<%=k%>,i  ,j) )
       call CHECK( __LINE__, val(KS<%=k*2+1%>,i,j) )
       call CHECK( __LINE__, val(KS<%=k*2%>,i,j) )
<% end %>
#endif
       ! The boundary condition is qflx_hi + qflxJ13 + qfluxJ23 = 0 at KS-1.
       ! The flux at KS-1 can be non-zero.
       ! To reduce calculations, all the fluxes are set to zero.
       flux(KS-1,i,j) = 0.0_RP
<% bnd_xyw.each do |kk, mks, dks, mke, dke| %>
<%= f2h_assigns(scalars_z, mks, dks) %>
       vel = <%= mks %> &
           / <%= dks %>
       flux(KS<%=kk%>,i,j) = J33G * vel &
                   * ( <%= flux("vel", [[order-(nh-kk)*2,[order,2].min].max,[order-(nh-kk-1)*2,[order,2].min].max], 0, "KS"+kk) %> ) <%= num_diff("KS"+kk) %>
<%= f2h_assigns(scalars_z, mke, dke) %>
       vel = <%= mke %> &
           / <%= dke %>
       flux(KE<%=-kk-1%>,i,j) = J33G * vel &
                   * ( <%= flux("vel", [[order-(nh-kk-1)*2,[order,2].min].max,[order-(nh-kk)*2,[order,2].min].max], 0, "KE"-(kk+1)) %> ) <%= num_diff("KE"-(kk+1)) %>
<% end %>
       flux(KE,i,j) = 0.0_RP
    enddo
    !$acc end kernels
    !$omp end do nowait

    else

<% end %>
    !$omp do OMP_SCHEDULE_ collapse(2)
    !$acc kernels
    do j = JJS, JJE
    do i = IIS, IIE
    do k = KS<%=nh%>, KE<%=-nh-1%>
#ifdef DEBUG
       call CHECK( __LINE__, mom(k,i,j) )
       call CHECK( __LINE__, mom(k,i<%=i%>,j<%=j%>) )
<% (nh+1).times do |k| %>
       call CHECK( __LINE__, val(k<%=-k%>,i,j) )
       call CHECK( __LINE__, val(k<%=k+1%>,i,j) )
<% end %>
#endif
<%= f2h_assigns(scalars_z, mom_uvw_k, dens_uvw_k) %>
       vel = <%= mom_uvw_k %> &
           / <%= dens_uvw_k %>
       flux(k,i,j) = J33G * vel &
                   * ( <%= flux("vel", order, 0) %> ) <%= num_diff() %>
    enddo
    enddo
    enddo
    !$acc end kernels
    !$omp end do nowait
#ifdef DEBUG
    k = IUNDEF; i = IUNDEF; j = IUNDEF
#endif

    !$omp do OMP_SCHEDULE_ collapse(2)
    !$acc kernels
    do j = JJS, JJE
    do i = IIS, IIE
#ifdef DEBUG
<% nh.times do |k| %>
       call CHECK( __LINE__, mom(KS<%=k%>,i  ,j) )
       call CHECK( __LINE__, mom(KS<%=k%>,i<%=i%>,j<%=j%>) )
       call CHECK( __LINE__, val(KS<%=k*2+1%>,i,j) )
       call CHECK( __LINE__, val(KS<%=k*2%>,i,j) )
<% end %>
#endif
       ! The boundary condition is qflx_hi + qflxJ13 + qfluxJ23 = 0 at KS-1.
       ! The flux at KS-1 can be non-zero.
       ! To reduce calculations, all the fluxes are set to zero.
       flux(KS-1,i,j) = 0.0_RP
<% bnd_uvw.each do |kk, mks, dks, mke, dke| %>
<%= f2h_assigns(scalars_z, mks, dks) %>
       vel = <%= mks %> &
           / <%= dks %>
       flux(KS<%=kk%>,i,j) = J33G * vel &
                   * ( <%= flux("vel", [[order-(nh-kk)*2,[order,2].min].max,[order-(nh-kk-1)*2,[order,2].min].max], 0, "KS"+kk) %> ) <%= num_diff("KS"+kk) %>
<%= f2h_assigns(scalars_z, mke, dke) %>
       vel = <%= mke %> &
           / <%= dke %>
       flux(KE<%=-kk-1%>,i,j) = J33G * vel &
                   * ( <%= flux("vel", [[order-(nh-kk-1)*2,[order,2].min].max,[order-(nh-kk)*2,[order,2].min].max], 0, "KE"-(kk+1)) %> ) <%= num_diff("KE"-(kk+1)) %>
<% end %>
       flux(KE,i,j) = 0.0_RP
    enddo
    enddo
    !$acc end kernels
    !$omp end do nowait
<% if i==1 %>
    end if
<% end %>

    !$acc end data

    !$omp end parallel
#ifdef DEBUG
    k = IUNDEF; i = IUNDEF; j = IUNDEF
#endif

    return
  end subroutine ATMOS_DYN_FVM_fluxZ_<%=uv%>Z_<%=@scheme%>
<% [
     ["J13", "UYZ", 2],
     ["J23", "XVZ", 1]
   ].each do |dir, xyz, im|
  scalars_j = {}
  mom_xyw_k = nil
  dens_xyw_k = nil
  bnd_xyw = []
  if i == 1 && im == 1
    mom_xyw_k = interp("mom", xyz, "XYW", "k", "i", "j", scalars_j)
    dens_xyw_k = interp("DENS", "XYZ", "XYW", "k", "i", "j", scalars_j)
    nh.times do |kk|
      bnd_xyw << [
        kk,
        interp("mom", xyz, "XYW", "KS"+kk, "i", "j", scalars_j),
        interp("DENS", "XYZ", "XYW", "KS"+kk, "i", "j", scalars_j),
        interp("mom", xyz, "XYW", "KE"-(kk+1), "i", "j", scalars_j),
        interp("DENS", "XYZ", "XYW", "KE"-(kk+1), "i", "j", scalars_j)
      ]
    end
  end
  mom_uvw_k = interp("mom", xyz, uv+"W", "k", "i", "j", scalars_j)
  dens_uvw_k = interp("DENS", "XYZ", uv+"W", "k", "i", "j", scalars_j)
  bnd_uvw = []
  nh.times do |kk|
    bnd_uvw << [
      kk,
      interp("mom", xyz, uv+"W", "KS"+kk, "i", "j", scalars_j),
      interp("DENS", "XYZ", uv+"W", "KS"+kk, "i", "j", scalars_j),
      interp("mom", xyz, uv+"W", "KE"-(kk+1), "i", "j", scalars_j),
      interp("DENS", "XYZ", uv+"W", "KE"-(kk+1), "i", "j", scalars_j)
    ]
  end
%>
  !-----------------------------------------------------------------------------
  !> calculation <%=dir%>-flux at <%=uv%>Z
  subroutine ATMOS_DYN_FVM_flux<%=dir%>_<%=uv%>Z_<%=@scheme%>( &
       flux,              &
       mom, val, DENS,    &
       GSQRT, <%=dir%>G, MAPF, &
       CDZ, TwoD,         &
       IIS, IIE, JJS, JJE )
    implicit none

    real(RP), intent(inout) :: flux    (KA,IA,JA)
    real(RP), intent(in)  :: mom     (KA,IA,JA)
    real(RP), intent(in)  :: val     (KA,IA,JA)
    real(RP), intent(in)  :: DENS    (KA,IA,JA)
    real(RP), intent(in)  :: GSQRT   (KA,IA,JA)
    real(RP), intent(in)  :: <%=dir%>G    (KA,IA,JA)
    real(RP), intent(in)  :: MAPF    (   IA,JA,2)
    real(RP), intent(in)  :: CDZ     (KA)
    logical,  intent(in)  :: TwoD
    integer,  intent(in)  :: IIS, IIE, JJS, JJE

    real(RP) :: vel
<%= f2h_decls(scalars_j) %>
    integer  :: k, i, j
    !---------------------------------------------------------------------------

    !$omp parallel default(none) private(i,j,k,vel) &
<%= f2h_privates(scalars_j) %>
    !$omp shared(JJS,JJE,IIS,IIE,KS,KE,mom,val,DENS,flux,<%=dir%>G,MAPF) &
    !$omp shared(GSQRT,CDZ,TwoD)

    !$acc data copy(flux) copyin(mom, val, DENS, GSQRT, <%=dir%>G, MAPF, CDZ)

<% if i==1 && im==1 %>
    if ( TwoD ) then

    !$omp do OMP_SCHEDULE_
    !$acc kernels
    do j = JJS, JJE
    do k = KS<%=nh%>, KE<%=-nh-1%>
       i = IIS
<%= f2h_assigns(scalars_j, mom_xyw_k, dens_xyw_k) %>
       vel = <%= mom_xyw_k %> &
           / <%= dens_xyw_k %>
       vel = vel * <%=dir%>G(k,i,j)
       flux(k,i,j) = vel * ( <%= flux("vel", order, 0) %> )
    enddo
    enddo
    !$acc end kernels
    !$omp end do nowait

    !$omp do OMP_SCHEDULE_
    !$acc kernels
    do j = JJS, JJE
       i = IIS
       ! The boundary condition is qflx_hi + qflxJ13 + qfluxJ23 = 0 at KS-1.
       ! The flux at KS-1 can be non-zero.
       ! To reduce calculations, all the fluxes are set to zero.
       flux(KS-1,i,j) = 0.0_RP
<% bnd_xyw.each do |kk, mks, dks, mke, dke| %>
<%= f2h_assigns(scalars_j, mks, dks) %>
       vel = <%= mks %> &
           / <%= dks %>
       vel = vel * <%=dir%>G(KS<%=kk%>,i,j)
       flux(KS<%=kk%>,i,j) = vel / MAPF(i,j,<%=im%>) &
                   * ( <%= flux("vel", [[order-(nh-kk)*2,[order,2].min].max,[order-(nh-kk-1)*2,[order,2].min].max], 0, "KS"+kk) %> )

<%= f2h_assigns(scalars_j, mke, dke) %>
       vel = <%= mke %> &
           / <%= dke %>
       vel = vel * <%=dir%>G(KE<%=-kk-1%>,i,j)
       flux(KE<%=-kk-1%>,i,j) = vel / MAPF(i,j,<%=im%>) &
                   * ( <%= flux("vel", [[order-(nh-kk-1)*2,[order,2].min].max,[order-(nh-kk)*2,[order,2].min].max], 0, "KE"-(kk+1)) %> )
<% end %>
       flux(KE  ,i,j) = 0.0_RP
    enddo
    !$acc end kernels
    !$omp end do nowait

    else
<% end %>

    !$omp do OMP_SCHEDULE_ collapse(2)
    !$acc kernels
    do j = JJS, JJE
    do i = IIS, IIE
    do k = KS<%=nh%>, KE<%=-nh-1%>
<%= f2h_assigns(scalars_j, mom_uvw_k, dens_uvw_k) %>
       vel = <%= mom_uvw_k %> &
           / <%= dens_uvw_k %>
       vel = vel * <%=dir%>G(k,i,j)
       flux(k,i,j) = vel / MAPF(i,j,<%=im%>) &
                   * ( <%= flux("vel", order, 0) %> )
    enddo
    enddo
    enddo
    !$acc end kernels
    !$omp end do nowait

    !$omp do OMP_SCHEDULE_ collapse(2)
    !$acc kernels
    do j = JJS, JJE
    do i = IIS, IIE
       ! The boundary condition is qflx_hi + qflxJ13 + qfluxJ23 = 0 at KS-1.
       ! The flux at KS-1 can be non-zero.
       ! To reduce calculations, all the fluxes are set to zero.
       flux(KS-1,i,j) = 0.0_RP
<% bnd_uvw.each do |kk, mks, dks, mke, dke| %>
<%= f2h_assigns(scalars_j, mks, dks) %>
       vel = <%= mks %> &
           / <%= dks %>
       vel = vel * <%=dir%>G(KS<%=kk%>,i,j)
       flux(KS<%=kk%>,i,j) = vel / MAPF(i,j,<%=im%>) &
                   * ( <%= flux("vel", [[order-(nh-kk)*2,[order,2].min].max,[order-(nh-kk-1)*2,[order,2].min].max], 0, "KS"+kk) %> )

<%= f2h_assigns(scalars_j, mke, dke) %>
       vel = <%= mke %> &
           / <%= dke %>
       vel = vel * <%=dir%>G(KE<%=-kk-1%>,i,j)
       flux(KE<%=-kk-1%>,i,j) = vel / MAPF(i,j,<%=im%>) &
                   * ( <%= flux("vel", [[order-(nh-kk-1)*2,[order,2].min].max,[order-(nh-kk)*2,[order,2].min].max], 0, "KE"-(kk+1)) %> )
<% end %>
       flux(KE  ,i,j) = 0.0_RP
    enddo
    enddo
    !$acc end kernels
    !$omp end do nowait

<% if i==1 && im==1 %>
    end if
<% end %>

    !$acc end data

    !$omp end parallel
    return
  end subroutine ATMOS_DYN_FVM_flux<%=dir%>_<%=uv%>Z_<%=@scheme%>
<% end # J13 J23 loop %>
<% [
     ["X", 1, 0],
     ["Y", 0, 1]
   ].each do |dir, ii, jj|
%>
  !-----------------------------------------------------------------------------
  !> calculation <%=dir%>-flux at <%=uv%>
  subroutine ATMOS_DYN_FVM_flux<%=dir%>_<%=uv%>Z_<%=@scheme%>( &
       flux,              &
       mom, val, DENS,    &
       GSQRT, MAPF,       &
       num_diff,          &
       CDZ, TwoD,         &
       IIS, IIE, JJS, JJE )
    implicit none

    real(RP), intent(inout) :: flux    (KA,IA,JA)
    real(RP), intent(in)  :: mom     (KA,IA,JA)
    real(RP), intent(in)  :: val     (KA,IA,JA)
    real(RP), intent(in)  :: DENS    (KA,IA,JA)
    real(RP), intent(in)  :: GSQRT   (KA,IA,JA)
    real(RP), intent(in)  :: MAPF    (   IA,JA,2)
    real(RP), intent(in)  :: num_diff(KA,IA,JA)
    real(RP), intent(in)  :: CDZ     (KA)
    logical,  intent(in)  :: TwoD
    integer,  intent(in)  :: IIS, IIE, JJS, JJE

    real(RP) :: vel
    integer  :: k, i, j
    !---------------------------------------------------------------------------
<% if uv=="UY" && dir=="X" %>
    ! note that x-index is added by -1
<%
     io = 1
   else
     io = 0
   end
   if uv=="XV" && dir=="Y"
%>
    ! note that y-index is added by -1
<%
     jo = 1
   else
     jo = 0
   end

   dst = uv
   if dir=="X"
     dst = dst[0..0]=="X" ? "U"+dst[1..1] : "X"+dst[1..1]
   else # dir=="Y"
     dst = dst[1..1]=="Y" ? dst[0..0]+"V" : dst[0..0]+"Y"
   end
%>

<% if i==1 && jj==1 %>
    if ( TwoD ) then

    !$omp parallel do default(none) private(i,j,k) OMP_SCHEDULE_ &
    !$omp private(vel) &
    !$omp shared(JJS,JJE,IIS,IIE,KS,KE,mom,val,DENS,flux,GSQRT,MAPF,num_diff,TwoD)
    !$acc kernels
    do j = JJS<%=-jj+jo%>, JJE<%=jo%>
    do k = KS, KE
       i = IIS
#ifdef DEBUG
       call CHECK( __LINE__, mom(k,i  ,j) )
<% (nh+1).times do |n| %>
       call CHECK( __LINE__, val(k,i<%=-n*ii-io%>,j<%=-n*jj-jo%>) )
       call CHECK( __LINE__, val(k,i<%=(n+1)*ii-io%>,j<%=(n+1)*jj-jo%>) )
<% end %>
#endif
       vel = <%= interp("mom", dir=="X" ? "UYZ" : "XVZ", "XVZ") %> &
           / <%= interp("DENS", "XYZ", "XVZ") %>
       flux(k,i<%=-io%>,j<%=-jo%>) = GSQRT(k,i,j) / MAPF(i,j,<%=ii*2+jj%>) * vel &
                   * ( <%= flux("vel", order, ii+jj*2, "k", "i"-io, "j"-jo) %> ) <%= num_diff() %>
    enddo
    enddo
    !$acc end kernels
#ifdef DEBUG
    k = IUNDEF; i = IUNDEF; j = IUNDEF
#endif

    else

<% end %>
    !$omp parallel do default(none) private(i,j,k) OMP_SCHEDULE_ collapse(2) &
    !$omp private(vel) &
    !$omp shared(JJS,JJE,IIS,IIE,KS,KE,mom,val,DENS,flux,GSQRT,MAPF,num_diff)
    !$acc kernels
    do j = JJS<%=-jj+jo%>, JJE<%=jo%>
    do i = IIS<%=-ii+io%>, IIE<%=io%>
    do k = KS, KE
#ifdef DEBUG
       call CHECK( __LINE__, mom(k,i  ,j) )
       call CHECK( __LINE__, mom(k,i<%=-i%>,j<%=-j%>) )
<% (nh+1).times do |n| %>
       call CHECK( __LINE__, val(k,i<%=-n*ii-io%>,j<%=-n*jj-jo%>) )
       call CHECK( __LINE__, val(k,i<%=(n+1)*ii-io%>,j<%=(n+1)*jj-jo%>) )
<% end %>
#endif
       vel = <%= interp("mom", dir=="X" ? "UYZ" : "XVZ", dst+"Z") %> &
           / <%= interp("DENS", "XYZ", dst+"Z") %>
       flux(k,i<%=-io%>,j<%=-jo%>) = GSQRT(k,i,j) / MAPF(i,j,<%=ii*2+jj%>) * vel &
                   * ( <%= flux("vel", order, ii+jj*2, "k", "i"-io, "j"-jo) %> ) <%= num_diff() %>
    enddo
    enddo
    enddo
    !$acc end kernels
#ifdef DEBUG
    k = IUNDEF; i = IUNDEF; j = IUNDEF
#endif

<% if i==1 && jj==1 %>
    end if
<% end %>

    return
  end subroutine ATMOS_DYN_FVM_flux<%=dir%>_<%=uv%>Z_<%=@scheme%>
<% end %>
<%# -- X Y loop ------- %>
<% end %>
<%# -- U V loop ------- %>

<% if @scheme == "ud3Koren1993" %>
  !-----------------------------------------------------------------------------
  function phi(v1, v2, v3)
    use scale_const, only: &
       EPS => CONST_EPS
    !$acc routine seq
    implicit none

    real(RP)              :: phi
#ifdef _OPENACC
    real(RP), intent(in), value :: v1
    real(RP), intent(in), value :: v2
    real(RP), intent(in), value :: v3
#else
    real(RP), intent(in) :: v1
    real(RP), intent(in) :: v2
    real(RP), intent(in) :: v3
#endif

    real(RP) :: r2
    real(RP) :: zerosw1, zerosw2
    !---------------------------------------------------------------------------

    zerosw1 = EPS - sign(EPS, abs(v1-v2)-EPS)
    zerosw2 = EPS - sign(EPS, abs(v2-v3)-EPS)
    r2 = 2.0_RP * (v1-v2+zerosw1*zerosw2) / (v2-v3+zerosw2)

    phi = max(0.0_RP, min(r2, min((1.0_RP+r2)/3.0_RP, 2.0_RP) ) )

  end function phi
<% end %>

end module <%= modname %>

